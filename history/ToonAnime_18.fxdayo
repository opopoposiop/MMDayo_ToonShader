#include "../hlsl/resources.hlsli"
#include "../hlsl/yrz.hlsli"
using namespace Dayo;
using namespace YRZ;
[YRZFX]
{
    "fx": {
        "cereal_class_version": 0,
        "category": "render",
        "textures": [
            {"name": "ZBuf",         "format": "D32_FLOAT",          "view": "DSV" },
            {"name": "RasterOut",    "format": "R16G16B16A16_FLOAT",  "view": "RTV" },
            {"name": "MyNormalDepth","format": "R32G32B32A32_FLOAT",  "view": "RTV" },
            {"name": "MyGBuffer1",   "format": "R32G32B32A32_FLOAT",  "view": "RTV" },
            {"name": "MyGBuffer2",   "format": "R32G32_FLOAT",        "view": "RTV" },
            {"name": "MyEmissive",   "format": "R16G16B16A16_FLOAT",  "view": "RTV" },
            {"name": "SSAO",         "format": "R8_UNORM",            "view": "UAV" },
            {"name": "BloomBuf",     "format": "R16G16B16A16_FLOAT",  "view": "UAV" },
            {"name": "BloomBuf2",    "format": "R16G16B16A16_FLOAT",  "view": "UAV" },
            {"name": "BloomBuf3",    "format": "R16G16B16A16_FLOAT",  "view": "UAV" },
            {"name": "BloomBuf4",    "format": "R16G16B16A16_FLOAT",  "view": "UAV" },
            {"name": "EmissiveBuf",  "format": "R16G16B16A16_FLOAT",  "view": "UAV" }
        ],
        "samplers": [
            { "name":"samp",      "filter":"ANISOTROPIC" },
            { "name":"ClampSamp", "filter":"LINEAR",  "addressU":"CLAMP", "addressV":"CLAMP" },
            { "name":"SkySamp",   "filter":"LINEAR",  "addressU":"WRAP",  "addressV":"CLAMP" },
            { "name":"PointSamp", "filter":"POINT",   "addressU":"CLAMP", "addressV":"CLAMP" }
        ],
        "passes": [
            {
                "name":"BG", "type":"postprocess",
                "pixelShader": "PS", "vertexShader": "VS",
                "RTV": [ {"name":"RasterOut", "clear":true, "value":{"x":0, "y":0, "z":0, "w":0} }]
            },
            {
                "name": "GBuffer",
                "type": "rasterizer", "vertexShader": "VS", "pixelShader": "PS",
                "DSV": { "name": "ZBuf", "clear": true, "depth": 1.0 },
                "RTV": [
                    { "name": "MyNormalDepth", "clear":true, "value":{"x":0, "y":0, "z":0, "w":0} },
                    { "name": "MyGBuffer1",    "clear":true, "value":{"x":-1, "y":-1, "z":-1, "w":-1} },
                    { "name": "MyGBuffer2",    "clear":true, "value":{"x":0, "y":0, "z":0, "w":0} },
                    { "name": "MyEmissive",    "clear":true, "value":{"x":0, "y":0, "z":0, "w":0} }
                ],
                "rasterizerDesc": { "cullMode": "none" }
            },
            {
                "name": "Edge",
                "type": "rasterizer", "vertexShader": "VS", "pixelShader": "PS",
                "DSV": { "name": "ZBuf", "clear": true, "depth": 1.0 },
                "RTV": [{ "name": "RasterOut", "clear": false }],
                "blendDesc": {
                    "renderTarget0": { "blendEnable": false }
                },
                "rasterizerDesc": { "cullMode": "front" }
            },
            {
                "name": "MMD",
                "type": "rasterizer", "vertexShader": "VS", "pixelShader": "PS",
                "DSV": { "name": "ZBuf", "clear": false },
                "RTV": [{ "name": "RasterOut", "clear": false }],
                "UAV": [ {"name":"EmissiveBuf"} ],
                "blendDesc": {
                    "renderTarget0": {
                        "blendEnable": true,
                        "srcBlend": "src_alpha", "destBlend": "inv_src_alpha", "blendOp": "add",
                        "srcBlendAlpha": "one",   "destBlendAlpha": "inv_src_alpha", "blendOpAlpha": "add"
                    }
                },
                "rasterizerDesc": { "cullMode": "none" }
            },
            {
                "name": "SSAO", "type": "raytracing",
                "raygenShader": "RayGeneration",
                "missShader":   [ "Miss" ],
                "hitGroup": [ { "type":"TRIANGLES", "closestHit":"ClosestHit", "anyHit":"AnyHit", "intersection":"" } ],
                "maxPayloadSize": 4, "maxAttributeSize": 8, "maxRecursionDepth": 1,
                "UAV": [ {"name":"SSAO"} ]
            },
            {
                "name":"Copy", "type":"postprocess", "pixelShader": "PS", "vertexShader": "VS",
                "UAV": [ {"name":"EmissiveBuf"} ]
            },
            {
                "name": "BloomExtract", "type": "postprocess",
                "pixelShader": "PS", "vertexShader": "VS",
                "UAV": [ {"name":"BloomBuf"}, {"name":"BloomBuf3"}, {"name":"EmissiveBuf"} ]
            },
            {
                "name": "BloomBlurH", "type": "postprocess",
                "pixelShader": "PS", "vertexShader": "VS",
                "UAV": [ {"name":"BloomBuf"}, {"name":"BloomBuf2"} ]
            },
            {
                "name": "BloomBlurV", "type": "postprocess",
                "pixelShader": "PS", "vertexShader": "VS",
                "UAV": [ {"name":"BloomBuf"}, {"name":"BloomBuf2"} ]
            },
            {
                "name": "BloomBlurH_Wide", "type": "postprocess",
                "pixelShader": "PS", "vertexShader": "VS",
                "UAV": [ {"name":"BloomBuf3"}, {"name":"BloomBuf4"} ]
            },
            {
                "name": "BloomBlurV_Wide", "type": "postprocess",
                "pixelShader": "PS", "vertexShader": "VS",
                "UAV": [ {"name":"BloomBuf3"}, {"name":"BloomBuf4"} ]
            },
            {"name":"BloomComposite", "type":"postprocess", "pixelShader": "PS", "vertexShader": "VS"},
            {"name":"DENOISE", "type":"postprocess", "pixelShader": "PS", "vertexShader": "VS", "conditions":["DenoiserEnabled"]},
            {"name":"FXAA",    "type":"postprocess", "pixelShader": "PS", "vertexShader": "VS"}
        ]
    }
}
[HLSL]

// ToonAnime_18.fxdayo
// ToonAnime_17.fxdayo をベースに作成
//
// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// 【ToonAnime_17 で残存していたバグの修正 (ToonAnime_18)】
// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
//
// ─── [Bug-1] 方式A emissiveScale の計算式ミス ← 最有力原因 ────────
//
//   ToonAnime_17 の式:
//     emissiveScale = (shininess - 100) / (110 - 100)
//                   = (shininess - 100) / 10
//
//   shininess = 100 → emissiveScale = 0.0  ← 発光しない!
//   shininess = 110 → emissiveScale = 1.0
//
//   問題: AutoLuminous.fx の仕様では shininess=100 が「標準発光(power=1.0)」。
//   PMXモデルの 発光モーフ が AutoLuminous 標準の shininess=100 を使っていると
//   isEmissive=true(判定通過) でも emissiveScale=0 となり一切発光しない。
//
//   ToonAnime_18 の修正式:
//     emissiveScale = (shininess - 100) / 10 + 1.0
//
//   shininess = 100 → emissiveScale = 1.0  ← AL標準発光 ✓
//   shininess = 110 → emissiveScale = 2.0
//   shininess = 170 → emissiveScale = 8.0  (AL_MAX_OVERBRIGHT 上限)
//
// ─── [Bug-2] MMDパスに発光出力が存在しない ────────────────────────
//
//   ToonAnime_17 では GBufferパス(不透明材質)の PSO が SV_TARGET3 経由で
//   MyEmissive に発光色を書き込むが、MMDパス(半透明/αブレンド材質)の PS は
//   MMDColor() を返すだけで発光計算を全く行っていなかった。
//
//   ToonAnime_18 の修正:
//     MMDパスの PS 内で CalcAutoLuminous() を呼び出し、
//     結果を EmissiveBuf UAV に直接書き込む。
//     (半透明材質で複数レイヤーが重なる場合は後書きが優先される。)
//
// ─── [Bug-3] Copyパスが EmissiveBuf を上書きする問題 ─────────────
//
//   ToonAnime_17 の Copy PS:
//     EmissiveBuf[pix] = MyEmissive[pix];   // 無条件上書き
//
//   MMDパスが EmissiveBuf に半透明発光を書き込んでも、
//   後続の Copyパスが MyEmissive(不透明発光) で上書きしてしまう。
//   不透明部分では MyEmissive が正しい値を持つが、
//   半透明部分では GBufferパスが走らないため MyEmissive=0 → 発光が消える。
//
//   ToonAnime_18 の修正:
//     EmissiveBuf[pix] = max(EmissiveBuf[pix], MyEmissive[pix]);
//
//   これにより:
//     不透明ピクセル → GBuffer発光 (MyEmissive) が MMD発光より明るければ優先
//     半透明ピクセル → MMD発光 (EmissiveBuf) が保持される (MyEmissive=0なので)
//
// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// ToonAnime_17 から継承した機能
// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
//
// [A] 頂点発光（追加UV / AutoLuminousSetter 方式B）
//     GBuffer/MMDパスの VS が exuv1/exuv2/exuv3 を受け取り PSへ補間渡し。
//     CalcAutoLuminous() が方式B(頂点発光)を方式A(材質発光)より優先判定。
//       STEP1: 識別コード (exuv1.xy ≈ 0.2, 0.7) → 方式B
//              exuv2.xyz * exuv2.w * blinkFactor で発光
//       STEP2: specular≈黒 & shininess>=100 → 方式A
//              (shininess-100)/10+1.0 * (diffuse+ambient) で発光 ← Bug-1修正済み
//
// [B] オーバーブライト発光スケール (R16G16B16A16_FLOAT で 1.0 超を格納)
//     方式A: emissiveScale = (shininess-100)/10+1.0  (shininess=100→1.0, 170→8.0)
//     方式B: power = clamp(exuv2.w, 0, AL_MAX_OVERBRIGHT)
//
// [C] デュアルレイヤー Bloom
//     タイト層(BloomBuf, σ=BLOOM_SIGMA): 輪郭を縁取る鋭いコロナ
//     ワイド層(BloomBuf3, σ=BLOOM_WIDE_SIGMA): 周囲に広がる光の靄
//     最終: RTOutput += BloomBuf * BLOOM_INTENSITY + BloomBuf3 * BLOOM_WIDE_INTENSITY
//
// [D] SSAO (レイトレーシング) / FXAA高品質版 / 2段階アニメ影
//
// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// PMX 発光モーフ 設定ガイド (AutoLuminous.fx 互換)
// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
//
//  方式A (材質発光・材質モーフで制御):
//    ・発光させたい材質のスペキュラ色 = 黒 (0,0,0)
//    ・スペキュラ強度(shininess) >= 100
//    ・shininess=100 → 標準発光(×1.0)  ← ToonAnime_18で修正、17では発光しなかった
//    ・shininess=140 → ×5.0 倍輝度
//    ・shininess=170 → ×8.0 倍 (上限)
//    ・発光色 = diffuse.rgb + ambient (テクスチャがあれば乗算)
//    ・材質モーフ「発光ON」: specular→黒, shininess→100以上 に変更するだけでOK
//
//  方式B (頂点発光・AutoLuminousSetter で設定):
//    ・AutoLuminousSetter (PMDEプラグイン) で発光頂点に追加UV設定
//    ・発光色/強度/点滅をモーフで動的に制御可能
//    ・識別コード: 追加UV1.x≈0.2, y≈0.7
//    ・発光色: 追加UV2.xyz (RGB or HSV), 強度: 追加UV2.w
//    ・点滅: 追加UV1.z=周期(秒), 追加UV3.y=位相
//
//  ※ MikuMikuDayo では AutoLuminous.fx/x そのものは動作しないが、
//    ToonAnime_18 が両方式を内部で検出・発光させる。

// Radeon向け: bindlessテクスチャ添え字をNonUniformResourceIndexで囲う
#define NURI NonUniformResourceIndex

// ============================================================
// エッジパラメータ
// ============================================================
static const float  EdgeWidth          = 0.002;
static const float  EdgeAlphaThreshold = 0.9;
static const float4 EDGE_GRAY          = float4(0.55, 0.55, 0.55, 1.0);

// ============================================================
// 2段階アニメ影パラメータ
// ============================================================
static const float SHADOW1_THRESHOLD = 0.1;
static const float SHADOW2_THRESHOLD = -0.15;
static const float SHADOW_SMOOTH     = 0.02;
static const float SHADOW1_MULT      = 0.65;
static const float SHADOW2_MULT      = 0.35;
static const float TOON_V_LIGHT      = 0.1;
static const float TOON_V_SHADOW1    = 0.5;
static const float TOON_V_SHADOW2    = 0.9;

// ============================================================
// SSAOパラメータ
// ============================================================
static const float AO_RADIUS   = 5.0;
static const float AO_BIAS     = 1e-3;
static const int   AO_SAMPLES  = 4;
static const float AO_STRENGTH = 0.5;

// ============================================================
// HDR Bloom / AutoLuminous互換パラメータ
// ============================================================
//
//  ▼ AutoLuminous.fx 互換の PMX 材質設定規則 ▼
//    発光させたい材質  : スペキュラ色 = 黒(0,0,0)
//                        スペキュラ強度(shininess) >= 100
//    標準的な発光強度  : shininess = 100（AL標準値, emissiveScale = 1.0）
//    モーフによる切替  : MMDMaterials[] はモーフ適用後の値
//                        → スペキュラ色モーフ・材質モーフが同フレームで反映
//
//  ▼ 発光強度スケール ▼
//    emissiveScale = clamp((shininess - 100) / 10 + 1.0, 0, AL_MAX_OVERBRIGHT)
//    shininess = 100 → 1.0  (AL標準)       ← ToonAnime_17 では 0.0 だったバグを修正
//    shininess = 110 → 2.0  (×2 輝度)
//    shininess = 140 → 5.0  (×5 輝度)
//    shininess = 170 → 8.0  (AL_MAX_OVERBRIGHT 上限)
//    ※ R16G16B16A16_FLOAT は 1.0 超の値を格納可能 → HDR加算合成で眩しさが出る
//
//  ▼ デュアルレイヤー Bloom パラメータ ▼
//    タイト層 (BloomBuf):  輪郭を縁取る鋭いコロナ
//    ワイド層 (BloomBuf3): 周囲に広がる柔らかい光の靄
//
//  AL_SPEC_THRESHOLD   : specular色の「黒」判定しきい値（≤この値 → 発光対象）
//  AL_SHIN_THRESHOLD   : 発光下限 shininess（ALと同じ 100）
//                        ※ ToonAnime_17 の AL_SHIN_STANDARD(=110) は削除
//                          新式では不要 (shininess=100 で emissiveScale=1.0 を直接返す)
//  AL_MAX_OVERBRIGHT   : emissiveScale の上限 (shininess=170 で上限に到達)
//  BLOOM_INTENSITY     : タイト層の RTOutput への加算強度
//  BLOOM_SIGMA         : タイト層ガウスぼかしのσ（ピクセル単位）
//  BLOOM_RADIUS        : タイト層カーネル半径（タップ数 = 2*RADIUS+1）
//  BLOOM_WIDE_INTENSITY: ワイド層の RTOutput への加算強度
//  BLOOM_WIDE_SIGMA    : ワイド層ガウスぼかしのσ（ピクセル単位）
//  BLOOM_WIDE_RADIUS   : ワイド層カーネル半径（タップ数 = 2*RADIUS+1）
static const float AL_SPEC_THRESHOLD    = 0.05;
static const float AL_SHIN_THRESHOLD    = 100.0;
// AL_SHIN_STANDARD は削除 (ToonAnime_17 のバグ原因となっていた定数)
// 新 emissiveScale 式: (shininess - AL_SHIN_THRESHOLD) / 10.0 + 1.0
static const float AL_MAX_OVERBRIGHT    = 8.0;
static const float BLOOM_INTENSITY      = 0.50;   // タイト層強度
static const float BLOOM_SIGMA          = 3.0;    // タイト層σ（鋭いコロナ）
static const int   BLOOM_RADIUS         = 6;      // タイト層半径（13tap）
static const float BLOOM_WIDE_INTENSITY = 0.20;   // ワイド層強度
static const float BLOOM_WIDE_SIGMA     = 12.0;   // ワイド層σ（広い光の靄）
static const int   BLOOM_WIDE_RADIUS    = 16;     // ワイド層半径（33tap）

// ============================================================
// FXAA高品質版パラメータ
// ============================================================
static const float FXAA_EDGE_THRESHOLD     = 0.063;
static const float FXAA_EDGE_THRESHOLD_MIN = 0.0312;
static const float FXAA_SUBPIX_QUALITY     = 0.75;
static const float FXAA_MAX_SPAN           = 12.0;


// ============================================================
// BGパス: スカイボックス描画
// ============================================================
#ifdef YRZ_PASS_BG
struct VSO {
	float4 position:SV_POSITION;
	float2 uv:TEXCOORD;
};

VSO VS( float4 pos : POSITION, float2 uv:TEXCOORD )
{
	VSO vso = (VSO)0;
	vso.position = pos;
	vso.position.w = 1;
	vso.uv = uv;
	return vso;
}

void RaySaySay(float2 Tex, out float3 ray, out float3 pos, uniform bool normalizeFlag = true)
{
	float2 tex = (Tex.xy - 0.5) * 2.0;
	if (Perspective) {
		ray =
			ViewMatrix._13_23_33 / ProjectionMatrix._33
			+ (ViewMatrix._11_21_31 * tex.x / ProjectionMatrix._11)
			- (ViewMatrix._12_22_32 * tex.y / ProjectionMatrix._22);
		if (normalizeFlag)
			ray = normalize(ray);
		pos = CameraPosition;
	} else {
		ray = CameraForward;
		pos = CameraPosition + CameraRight * tex.x / ProjectionMatrix._11 - CameraUp * tex.y / ProjectionMatrix._22;
	}
}

static float SkyboxPhi = 0;

float2 LongRat(float3 v)
{
	return float2(atan2(v.z, v.x), acos(v.y)) / float2(-2 * PI, PI) - float2(0.25 + SkyboxPhi, 0);
}

float4 PS(VSO vso) : SV_TARGET
{
	float4 o = 0;
	float3 rd, ro;
	RaySaySay(vso.uv, rd, ro);
	float2 uv = LongRat(rd);
	o = Skybox.SampleLevel(SkySamp, uv, 0);
	return float4(o.rgb, 0);
}
#endif


// ============================================================
// Edgeパス: 外形(シルエット)エッジ描画
//   edgeSize >= 1.0 → m.edgeColor  /  edgeSize < 1.0 → EDGE_GRAY
// ============================================================
#ifdef YRZ_PASS_Edge
struct VSO {
	float4 position:SV_POSITION;
};

VSO VS( float4 pos : POSITION, float3 normal:NORMAL, float3 tangent:TANGENT, float2 uv:TEXCOORD )
{
	VSO o = (VSO)0;
	float4 clipPos = mul(pos, ViewProjectionMatrix);

	float3 viewNormal = mul(normal, (float3x3)ViewMatrix);
	float2 dir = viewNormal.xy;

	float len = length(dir);
	if (len < 1e-5) dir = float2(1, 0);
	else            dir /= len;

	clipPos.xy += dir * EdgeWidth * clipPos.w;
	o.position = clipPos;
	return o;
}

float4 PS(VSO vso, uint iFace:SV_PrimitiveID) : SV_TARGET
{
	uint imo = ModelIndex;
	MMDMaterial m = MMDMaterials[imo][Faces[imo][iFace]];
	if (m.diffuse.a < EdgeAlphaThreshold) discard;
	return (m.edgeSize >= 1.0) ? m.edgeColor : EDGE_GRAY;
}
#endif


// ============================================================
// MMDパス & GBufferパス: 2段階アニメ調トゥーンシェーディング
//
//  GBufferパスでは通常の3出力に加え、第4出力 MyEmissive(SV_TARGET3) に
//  AutoLuminous発光色を書き込む。
//
//  ToonAnime_18 の変更点:
//    MMDパス PS でも CalcAutoLuminous() を呼び出し、
//    半透明発光材質の発光色を EmissiveBuf UAV に直接書き込む。
//    (Bug-2修正: MMDパスに発光出力を追加)
//
//  VSO は GBuffer/MMD 共用。VS が exuv1/exuv2/exuv3 を補間器に渡すため、
//  MMDパス PS でも方式B(頂点発光)が参照できる。
// ============================================================
#if defined(YRZ_PASS_MMD) || defined(YRZ_PASS_GBuffer)
struct VSO {
	float4 position:SV_POSITION;
	float3 normal:NORMAL;
	float2 uv:TEXCOORD;
	float2 spuv:TEXCOORD1;
	float3 eye:TEXCOORD2;
	float  viewZ:TEXCOORD3;   // ビュー空間Z深度（SSAO位置再構築用）
	// AutoLuminous 頂点発光用 追加UV (方式B)
	float4 exuv1:TEXCOORD4;   // xy=識別コード(0.2,0.7) z=点滅周期(秒) w=フラグ
	float4 exuv2:TEXCOORD5;   // xyz=発光RGB  w=発光強度(Power)
	float4 exuv3:TEXCOORD6;   // x=テクスチャ色係数 y=点滅位相(秒) z=ポップアップ
};

VSO VS( float4 pos : POSITION, float3 normal:NORMAL, float3 tangent:TANGENT, float2 uv:TEXCOORD,
        float4 exuv1:TEXCOORD1, float4 exuv2:TEXCOORD2, float4 exuv3:TEXCOORD3, float4 exuv4:TEXCOORD4 )
{
	VSO o = (VSO)0;
	o.position = mul(pos, ViewProjectionMatrix);
	o.uv       = uv;
	o.spuv     = mul(normal, (float3x2)ViewMatrix) * float2(0.5, -0.5) + 0.5;
	o.normal   = normal;
	o.eye      = CameraPosition - pos.xyz;
	o.viewZ    = mul(pos, ViewMatrix).z;
	// 追加UV をそのまま補間器に渡す（ラスタライザが頂点間で補間する）
	o.exuv1    = exuv1;
	o.exuv2    = exuv2;
	o.exuv3    = exuv3;
	return o;
}

void CalcAnimeShadow(float NoL, out float inShadow1, out float inShadow2)
{
	inShadow1 = 1.0 - smoothstep(SHADOW1_THRESHOLD - SHADOW_SMOOTH,
	                              SHADOW1_THRESHOLD + SHADOW_SMOOTH, NoL);
	inShadow2 = 1.0 - smoothstep(SHADOW2_THRESHOLD - SHADOW_SMOOTH,
	                              SHADOW2_THRESHOLD + SHADOW_SMOOTH, NoL);
}

float4 MMDColor(VSO vso, uint iFace, bool vface)
{
	uint imo = ModelIndex;
	MMDMaterial m = MMDMaterials[imo][Faces[imo][iFace]];

	if (!vface && ((m.drawFlag & 1) == 0)) discard;

	float3 Le  = LightColor;
	float3 L   = -LightDirection;
	float3 N   = vso.normal;
	float3 V   = normalize(vso.eye);
	float3 H   = normalize(L + V);
	float  NoL = dot(N, L);
	uint  tidx = TextureTable[imo];

	float4 tex = 1;
	if (m.tex >= 0) {
		tex = Textures[NURI(tidx + m.tex)].Sample(samp, vso.uv);
		tex.rgb = lerp(1, tex.rgb * m.textureMulValue.rgb + m.textureAddValue.rgb,
		               m.textureMulValue.a + m.textureAddValue.a);
	}

	float4 o = float4(saturate(m.diffuse.rgb * Le + m.ambient), m.diffuse.a) * tex;

	float inShadow1, inShadow2;
	CalcAnimeShadow(NoL, inShadow1, inShadow2);

	if (m.toonFlag == 0 && m.toonTex >= 0) {
		float toonV = lerp(lerp(TOON_V_LIGHT, TOON_V_SHADOW1, inShadow1),
		                   TOON_V_SHADOW2, inShadow2);
		o *= Textures[NURI(tidx + m.toonTex)].Sample(ClampSamp, float2(0.0, toonV));
	} else if (m.toonFlag == 1) {
		float mult = lerp(lerp(1.0, SHADOW1_MULT, inShadow1), SHADOW2_MULT, inShadow2);
		o.rgb *= mult;
	}

	if (m.spTex >= 0 && (m.spmode == 1 || m.spmode == 2)) {
		float4 sptex = Textures[NURI(tidx + m.spTex)].Sample(samp, vso.spuv);
		sptex.rgb = lerp(m.spmode == 1 ? 1 : 0,
		                 sptex.rgb * m.sphereMulValue.rgb + m.sphereAddValue.rgb,
		                 m.sphereAddValue.a + m.sphereMulValue.a);
		o.rgb = (m.spmode == 1) ? o.rgb * sptex.rgb : o.rgb + sptex.rgb;
		o.a  *= sptex.a;
	}

	o.rgb += m.specular * Le * pow(max(1e-6, dot(N, H)), m.shininess);

	if (o.a == 0) discard;
	if (o.a >= 0.98) o.a = 1;

	o.rgb = ToLinear(o.rgb);
	return o;
}

// ──────────────────────────────────────────────────────────────
// AutoLuminous互換 発光色計算ヘルパー (ToonAnime_18: Bug-1修正版)
//
//  方式B (頂点発光) を方式A (材質発光) より優先して判定する。
//
//  ▼ 方式B: 頂点発光 (AutoLuminousSetter で設定、追加UV使用)
//    識別コード: exuv1.x ≈ 0.2 かつ exuv1.y ≈ 0.7
//    発光色:    exuv1.w の10の位=0 → exuv2.xyz = RGB
//               exuv1.w の10の位=1 → exuv2.xyz = HSV → HSVtoRGB 変換
//    発光強度:  exuv2.w (Power 値) を AL_MAX_OVERBRIGHT で上限制御
//    点滅:      exuv1.z = 点滅周期(秒)
//               > 0 → 正弦波: 0.5 + 0.5*sin(2π*(Time+exuv3.y)/period)
//               < 0 → 矩形波: step(0, sin(2π*(Time+exuv3.y)/|period|))
//               = 0 → 常時点灯 (blinkFactor = 1.0)
//
//  ▼ 方式A: 材質発光 (PMXエディタで材質設定)  ← Bug-1修正
//    条件: specular色が黒に近い (max RGB ≤ AL_SPEC_THRESHOLD)
//          かつ shininess ≥ AL_SHIN_THRESHOLD (100)
//    発光色: diffuse.rgb + ambient、テクスチャを乗算
//    発光強度スケール: clamp((shininess - 100) / 10 + 1.0, 0, AL_MAX_OVERBRIGHT)
//      shininess=100 → 1.0 (AL標準) ← 修正前は 0.0 で発光しなかった
//      shininess=110 → 2.0
//      shininess=170 → 8.0 (上限)
// ──────────────────────────────────────────────────────────────

// HSV→RGB 変換ヘルパー（方式B のカラーモード=1 用）
float3 HSVtoRGBLocal(float3 hsv)
{
	float h = hsv.x * 6.0;
	float s = hsv.y;
	float v = hsv.z;
	float i = floor(h);
	float f = h - i;
	float p = v * (1.0 - s);
	float q = v * (1.0 - s * f);
	float t = v * (1.0 - s * (1.0 - f));
	int   ii = (int)i % 6;
	if (ii == 0) return float3(v, t, p);
	if (ii == 1) return float3(q, v, p);
	if (ii == 2) return float3(p, v, t);
	if (ii == 3) return float3(p, q, v);
	if (ii == 4) return float3(t, p, v);
	             return float3(v, p, q);
}

float3 CalcAutoLuminous(uint imo, uint iFace, float2 uv, float4 exuv1, float4 exuv2, float4 exuv3)
{
	// ── 方式B: 頂点発光（識別コード確認） ────────────────────────
	// 追加UV1.xy が AutoLuminous 識別コード (0.2, 0.7) に近い場合
	bool isVertexLuminous = (abs(exuv1.x - 0.2) < 0.05) && (abs(exuv1.y - 0.7) < 0.05);

	if (isVertexLuminous)
	{
		// ── 点滅係数の計算 ──────────────────────────────────────
		// exuv1.z = 点滅周期(秒): 正=正弦波、負=矩形波、0=常時点灯
		float blinkFactor = 1.0;
		float period = exuv1.z;
		if (abs(period) > 1e-4) {
			float phase  = exuv3.y;  // 点滅位相(秒)
			float theta  = 2.0 * PI * (Time + phase) / abs(period);
			if (period > 0.0)
				blinkFactor = saturate(0.5 + 0.5 * sin(theta));  // 正弦波
			else
				blinkFactor = step(0.0, sin(theta));              // 矩形波
		}

		// ── 発光色の決定 ─────────────────────────────────────
		// exuv1.w のフラグ:
		//   1の位  = テクスチャモード (0=乗算、1=なし)
		//   10の位 = カラーモード    (0=RGB、1=HSV)
		int  flags     = (int)round(exuv1.w);
		int  texMode   = flags % 10;       // 1の位
		int  colorMode = (flags / 10) % 10; // 10の位

		float3 emitColor = exuv2.xyz;
		if (colorMode == 1)
			emitColor = HSVtoRGBLocal(saturate(exuv2.xyz));  // HSV → RGB 変換

		// テクスチャ乗算 (texMode=0: 材質テクスチャを exuv3.x 係数で乗算)
		uint imo2 = ModelIndex;
		uint tidx = TextureTable[imo2];
		MMDMaterial m2 = MMDMaterials[imo2][Faces[imo2][iFace]];
		if (texMode == 0 && m2.tex >= 0) {
			float4 texCol = Textures[NURI(tidx + m2.tex)].Sample(samp, uv);
			texCol.rgb = lerp(1.0,
			                  texCol.rgb * m2.textureMulValue.rgb + m2.textureAddValue.rgb,
			                  m2.textureMulValue.a + m2.textureAddValue.a);
			// exuv3.x = テクスチャ色係数 (負値でクランプ後0、0〜1で乗算係数)
			float texFactor = max(0.0, exuv3.x);
			emitColor *= lerp(1.0, texCol.rgb, texFactor);
		}

		// ── 発光強度 (Power = exuv2.w) ──────────────────────────
		float power = clamp(exuv2.w, 0.0, AL_MAX_OVERBRIGHT);

		return ToLinear(saturate(emitColor)) * power * blinkFactor;
	}

	// ── 方式A: 材質発光（Bug-1修正: shininess=100 → emissiveScale=1.0）──
	MMDMaterial m = MMDMaterials[imo][Faces[imo][iFace]];

	float specMax    = max(m.specular.r, max(m.specular.g, m.specular.b));
	bool  isEmissive = (specMax <= AL_SPEC_THRESHOLD) && (m.shininess >= AL_SHIN_THRESHOLD);

	if (!isEmissive)
		return 0;

	// ★ Bug-1 修正箇所 ★
	// ToonAnime_17: (shininess - 100) / 10         → shininess=100 で 0.0 (発光しない!)
	// ToonAnime_18: (shininess - 100) / 10 + 1.0   → shininess=100 で 1.0 (AL標準) ✓
	float emissiveScale = clamp(
		(m.shininess - AL_SHIN_THRESHOLD) / 10.0 + 1.0,
		0.0, AL_MAX_OVERBRIGHT);

	float3 glowBase = m.diffuse.rgb + m.ambient;

	uint tidxA = TextureTable[imo];
	if (m.tex >= 0) {
		float4 texCol = Textures[NURI(tidxA + m.tex)].Sample(samp, uv);
		texCol.rgb = lerp(1.0,
		                  texCol.rgb * m.textureMulValue.rgb + m.textureAddValue.rgb,
		                  m.textureMulValue.a + m.textureAddValue.a);
		glowBase *= texCol.rgb;
	}

	return ToLinear(saturate(glowBase)) * emissiveScale;
}

	#ifdef YRZ_PASS_MMD
		// ── MMDパス PS (Bug-2修正: 半透明発光材質を EmissiveBuf に出力) ──
		//
		//  ToonAnime_17: MMDパスは MMDColor() を返すのみで発光出力なし。
		//  ToonAnime_18: CalcAutoLuminous() で発光色を計算し、EmissiveBuf UAV に書き込む。
		//
		//  注意事項:
		//   ・半透明材質が複数レイヤー重なる場合、後に描画されたレイヤーが EmissiveBuf を上書きする。
		//     (レイヤー間のmax合成は行わない。大半のユースケースでは問題なし。)
		//   ・不透明発光材質は GBufferパスで MyEmissive に書き込まれ、
		//     Copyパスの max 合成で EmissiveBuf に反映される。
		float4 PS(VSO vso, uint iFace:SV_PrimitiveID, bool vface:SV_IsFrontFace) : SV_TARGET
		{
			// 半透明発光材質の発光色を EmissiveBuf に書き込む (Bug-2修正)
			// CalcAutoLuminous は方式B/Aの両方に対応 (vso.exuv1/2/3 は VS から補間済み)
			uint2  pix     = trunc(vso.position.xy);
			float3 emissive = CalcAutoLuminous(ModelIndex, iFace, vso.uv,
			                                   vso.exuv1, vso.exuv2, vso.exuv3);
			EmissiveBuf[pix] = float4(emissive, 1.0);

			return MMDColor(vso, iFace, vface);
		}
	#else
		// ── GBufferパス出力構造体 ──────────────────────────────────
		struct PSO {
			float4 NormalDepth : SV_TARGET0;  // 法線(rgb) + ビュー空間Z深度(a)
			float4 GBuffer1    : SV_TARGET1;  // ModelIndex + iFace（ビット圧縮）
			float2 GBuffer2    : SV_TARGET2;  // 重心座標 .yz
			float4 Emissive    : SV_TARGET3;  // AutoLuminous互換 発光色（オーバーブライト対応）
		};

		#ifndef NO_BARYCENTRICS
		PSO PS(VSO vso, uint iFace:SV_PrimitiveID, bool vface:SV_IsFrontFace, float3 bary:SV_Barycentrics) {
		#else
		PSO PS(VSO vso, uint iFace:SV_PrimitiveID, bool vface:SV_IsFrontFace) {
			float3 bary = 0;
		#endif
			PSO o = (PSO)0;

			// 発光色を計算 (方式B優先 → 方式A、Bug-1修正済みの emissiveScale を使用)
			// vso.exuv1/2/3 は VS で追加UV から補間済みのため方式B も正しく動作する
			float3 emissive = CalcAutoLuminous(ModelIndex, iFace, vso.uv,
			                                   vso.exuv1, vso.exuv2, vso.exuv3);
			o.Emissive = float4(emissive, 1.0);

			float4 c = MMDColor(vso, iFace, vface);
			if (c.a < AlphaThreshold) discard;

			o.NormalDepth = float4(vso.normal, vso.viewZ);
			o.GBuffer1.r  = ModelIndex & 0x00FFFFFF;
			o.GBuffer1.g  = ModelIndex >> 24;
			o.GBuffer1.b  = iFace & 0x00FFFFFF;
			o.GBuffer1.a  = iFace >> 24;
			o.GBuffer2    = bary.yz;

			return o;
		}
	#endif

#endif


// ============================================================
// SSAOパス: レイトレーシングによるアンビエントオクルージョン
// ============================================================
#ifdef YRZ_PASS_SSAO
#define RAYTRACING

struct SSAOPayload {
	float t;
};

float3 SSAOUVtoWorld(float2 uv, float depth)
{
	float2 tex = (uv - 0.5) * 2.0;
	float3 ray;
	if (Perspective) {
		ray = ViewMatrix._13_23_33 / ProjectionMatrix._33
		    + (ViewMatrix._11_21_31 *  tex.x / ProjectionMatrix._11)
		    - (ViewMatrix._12_22_32 *  tex.y / ProjectionMatrix._22);
	} else {
		float3 lateral = CameraRight * tex.x / ProjectionMatrix._11
		               - CameraUp    * tex.y / ProjectionMatrix._22;
		return CameraPosition + lateral + CameraForward * depth;
	}
	return CameraPosition + ray * depth;
}

[shader("raygeneration")]
void RayGeneration()
{
	uint2  pix = DispatchRaysIndex().xy;
	float2 uv  = (pix + 0.5) / (float2)DispatchRaysDimensions().xy;

	float4 nd = MyNormalDepth.SampleLevel(PointSamp, uv, 0);
	if (nd.w == 0.0) { SSAO[pix] = 0.0; return; }

	float3 P = SSAOUVtoWorld(uv, nd.w);
	float3 N = normalize(nd.xyz);
	float3x3 TBN = ComputeTBN(N);

	float occlusion = 0.0;
	[loop]
	for (int i = 0; i < AO_SAMPLES; i++) {
		float4 xi = Hash4(uint4(pix.x, pix.y, (uint)(iSample) * (uint)AO_SAMPLES + (uint)i, 7919u));
		float  pdf;
		float3 dir = SampleCosWeightedHemisphere(TBN, xi.xy, pdf);

		SSAOPayload payload;
		payload.t = -1.0;

		RayDesc ray;
		ray.Origin    = P + N * (nd.w * AO_BIAS);
		ray.Direction = dir;
		ray.TMin      = 0.0;
		ray.TMax      = AO_RADIUS;
		TraceRay(TLAS, RAY_FLAG_ACCEPT_FIRST_HIT_AND_END_SEARCH, 0xFF, 0, 0, 0, ray, payload);

		if (payload.t >= 0.0)
			occlusion += 1.0 - saturate(payload.t / AO_RADIUS);
	}
	occlusion /= (float)AO_SAMPLES;

	float prev  = SSAO[pix].r;
	float alpha = 1.0 / ((float)iSample + 1.0);
	SSAO[pix]   = lerp(prev, occlusion, alpha);
}

[shader("miss")]
void Miss(inout SSAOPayload payload) { }

[shader("closesthit")]
void ClosestHit(inout SSAOPayload payload, Attribute attr)
{
	payload.t = RayTCurrent();
}

[shader("anyhit")]
void AnyHit(inout SSAOPayload payload, Attribute attr) { }

#endif


// ============================================================
// Copyパス: RasterOut → RTOutput コピー & SSAO適用 & 発光バッファ合成
//
//  Bug-3修正: EmissiveBuf への書き込みを「上書き」から「max合成」に変更。
//
//  ToonAnime_17:
//    EmissiveBuf[pix] = MyEmissive[pix];
//    → MMDパスが EmissiveBuf に書き込んだ半透明発光を上書きしてしまう。
//       半透明ピクセルでは MyEmissive=0 なので、MMD発光が消える。
//
//  ToonAnime_18:
//    EmissiveBuf[pix] = max(EmissiveBuf[pix], MyEmissive[pix]);
//    → GBuffer発光(MyEmissive) と MMD発光(EmissiveBuf) を成分ごとに最大値で合成。
//       不透明ピクセル: GBuffer発光が優先 (通常 MyEmissive > 0)
//       半透明ピクセル: MMD発光が保持  (MyEmissive=0 なので max 後も MMD値)
// ============================================================
#ifdef YRZ_PASS_Copy

struct VSO {
	float4 position:SV_POSITION;
	float2 uv:TEXCOORD;
};

VSO VS( float4 pos : POSITION, float2 uv:TEXCOORD )
{
	VSO vso = (VSO)0;
	vso.position = pos;
	vso.position.w = 1;
	vso.uv = uv;
	return vso;
}

float4 PS(VSO vso) : SV_TARGET
{
	uint2  pix   = trunc(vso.position.xy);
	float  ao    = SSAO[pix].r;
	float4 color = RasterOut[pix];
	color.rgb   *= (1.0 - AO_STRENGTH * ao);
	RTOutput[pix] = color;

	float4 G1 = MyGBuffer1[pix];
	GBuffer1[pix].r = (G1.r < 0) ? -1 : (uint)G1.r | ((uint)G1.g << 24);
	GBuffer1[pix].g = (G1.b < 0) ? -1 : (uint)G1.b | ((uint)G1.a << 24);
	GBuffer2[pix]    = MyGBuffer2[pix];
	NormalDepth[pix] = MyNormalDepth[pix];

	// ★ Bug-3 修正箇所 ★
	// GBuffer発光(MyEmissive) と MMD発光(EmissiveBuf) を max 合成する。
	// 不透明ピクセル: max(MMD発光, GBuffer発光) ≈ GBuffer発光 (通常GBufferが大きい)
	// 半透明ピクセル: max(MMD発光, 0) = MMD発光 (MyEmissive=0 のため)
	// HDR値(> 1.0)も R16G16B16A16_FLOAT で損失なく保持される。
	EmissiveBuf[pix] = max(EmissiveBuf[pix], MyEmissive[pix]);

	discard;
	return 0;
}

#endif


// ============================================================
// BloomExtractパス: EmissiveBuf → BloomBuf (タイト層) & BloomBuf3 (ワイド層)
//
//  GBuffer発光(不透明) と MMD発光(半透明) が max 合成された EmissiveBuf を
//  両ブルームバッファへ展開する。
// ============================================================
#ifdef YRZ_PASS_BloomExtract

struct VSO {
	float4 position:SV_POSITION;
	float2 uv:TEXCOORD;
};

VSO VS( float4 pos : POSITION, float2 uv:TEXCOORD )
{
	VSO vso = (VSO)0;
	vso.position = pos;
	vso.position.w = 1;
	vso.uv = uv;
	return vso;
}

float4 PS(VSO vso) : SV_TARGET
{
	uint2 pix = trunc(vso.position.xy);
	float4 em = EmissiveBuf[pix];
	BloomBuf[pix]  = em;  // タイト層ガウスブラーの入力
	BloomBuf3[pix] = em;  // ワイド層ガウスブラーの入力
	discard;
	return 0;
}

#endif


// ============================================================
// BloomBlurHパス: タイト層 水平ガウスぼかし（BloomBuf → BloomBuf2）
//   σ = BLOOM_SIGMA, 半径 = BLOOM_RADIUS
// ============================================================
#ifdef YRZ_PASS_BloomBlurH

struct VSO {
	float4 position:SV_POSITION;
	float2 uv:TEXCOORD;
};

VSO VS( float4 pos : POSITION, float2 uv:TEXCOORD )
{
	VSO vso = (VSO)0;
	vso.position = pos;
	vso.position.w = 1;
	vso.uv = uv;
	return vso;
}

float GaussW(float x) { return exp(-x * x / (2.0 * BLOOM_SIGMA * BLOOM_SIGMA)); }

float4 PS(VSO vso) : SV_TARGET
{
	uint2 pix   = trunc(vso.position.xy);
	int2  bound = int2(Resolution) - 1;
	float3 result = 0.0;
	float  totalW = 0.0;

	[unroll]
	for (int i = -BLOOM_RADIUS; i <= BLOOM_RADIUS; i++) {
		float w   = GaussW((float)i);
		int2  src = clamp(int2(pix) + int2(i, 0), int2(0, 0), bound);
		result   += BloomBuf[src].rgb * w;
		totalW   += w;
	}

	BloomBuf2[pix] = float4(result / totalW, 1.0);
	discard;
	return 0;
}

#endif


// ============================================================
// BloomBlurVパス: タイト層 垂直ガウスぼかし（BloomBuf2 → BloomBuf）
//   σ = BLOOM_SIGMA, 半径 = BLOOM_RADIUS
// ============================================================
#ifdef YRZ_PASS_BloomBlurV

struct VSO {
	float4 position:SV_POSITION;
	float2 uv:TEXCOORD;
};

VSO VS( float4 pos : POSITION, float2 uv:TEXCOORD )
{
	VSO vso = (VSO)0;
	vso.position = pos;
	vso.position.w = 1;
	vso.uv = uv;
	return vso;
}

float GaussW(float x) { return exp(-x * x / (2.0 * BLOOM_SIGMA * BLOOM_SIGMA)); }

float4 PS(VSO vso) : SV_TARGET
{
	uint2 pix   = trunc(vso.position.xy);
	int2  bound = int2(Resolution) - 1;
	float3 result = 0.0;
	float  totalW = 0.0;

	[unroll]
	for (int i = -BLOOM_RADIUS; i <= BLOOM_RADIUS; i++) {
		float w   = GaussW((float)i);
		int2  src = clamp(int2(pix) + int2(0, i), int2(0, 0), bound);
		result   += BloomBuf2[src].rgb * w;
		totalW   += w;
	}

	BloomBuf[pix] = float4(result / totalW, 1.0);
	discard;
	return 0;
}

#endif


// ============================================================
// BloomBlurH_Wideパス: ワイド層 水平ガウスぼかし（BloomBuf3 → BloomBuf4）
//   σ = BLOOM_WIDE_SIGMA, 半径 = BLOOM_WIDE_RADIUS
// ============================================================
#ifdef YRZ_PASS_BloomBlurH_Wide

struct VSO {
	float4 position:SV_POSITION;
	float2 uv:TEXCOORD;
};

VSO VS( float4 pos : POSITION, float2 uv:TEXCOORD )
{
	VSO vso = (VSO)0;
	vso.position = pos;
	vso.position.w = 1;
	vso.uv = uv;
	return vso;
}

float GaussWide(float x) { return exp(-x * x / (2.0 * BLOOM_WIDE_SIGMA * BLOOM_WIDE_SIGMA)); }

float4 PS(VSO vso) : SV_TARGET
{
	uint2 pix   = trunc(vso.position.xy);
	int2  bound = int2(Resolution) - 1;
	float3 result = 0.0;
	float  totalW = 0.0;

	[unroll]
	for (int i = -BLOOM_WIDE_RADIUS; i <= BLOOM_WIDE_RADIUS; i++) {
		float w   = GaussWide((float)i);
		int2  src = clamp(int2(pix) + int2(i, 0), int2(0, 0), bound);
		result   += BloomBuf3[src].rgb * w;
		totalW   += w;
	}

	BloomBuf4[pix] = float4(result / totalW, 1.0);
	discard;
	return 0;
}

#endif


// ============================================================
// BloomBlurV_Wideパス: ワイド層 垂直ガウスぼかし（BloomBuf4 → BloomBuf3）
//   σ = BLOOM_WIDE_SIGMA, 半径 = BLOOM_WIDE_RADIUS
// ============================================================
#ifdef YRZ_PASS_BloomBlurV_Wide

struct VSO {
	float4 position:SV_POSITION;
	float2 uv:TEXCOORD;
};

VSO VS( float4 pos : POSITION, float2 uv:TEXCOORD )
{
	VSO vso = (VSO)0;
	vso.position = pos;
	vso.position.w = 1;
	vso.uv = uv;
	return vso;
}

float GaussWide(float x) { return exp(-x * x / (2.0 * BLOOM_WIDE_SIGMA * BLOOM_WIDE_SIGMA)); }

float4 PS(VSO vso) : SV_TARGET
{
	uint2 pix   = trunc(vso.position.xy);
	int2  bound = int2(Resolution) - 1;
	float3 result = 0.0;
	float  totalW = 0.0;

	[unroll]
	for (int i = -BLOOM_WIDE_RADIUS; i <= BLOOM_WIDE_RADIUS; i++) {
		float w   = GaussWide((float)i);
		int2  src = clamp(int2(pix) + int2(0, i), int2(0, 0), bound);
		result   += BloomBuf4[src].rgb * w;
		totalW   += w;
	}

	BloomBuf3[pix] = float4(result / totalW, 1.0);
	discard;
	return 0;
}

#endif


// ============================================================
// BloomCompositeパス: デュアルレイヤーブルームを RTOutput に加算合成
//
//  RTOutput += BloomBuf  * BLOOM_INTENSITY      ← タイト層 (鋭いコロナ)
//           += BloomBuf3 * BLOOM_WIDE_INTENSITY  ← ワイド層 (光の靄)
//
//  ToonAnime_18 ではGBuffer発光+MMD発光が max 合成された EmissiveBuf を
//  ソースとするため、不透明・半透明を問わず発光材質がブルームに寄与する。
// ============================================================
#ifdef YRZ_PASS_BloomComposite

struct VSO {
	float4 position:SV_POSITION;
	float2 uv:TEXCOORD;
};

VSO VS( float4 pos : POSITION, float2 uv:TEXCOORD )
{
	VSO vso = (VSO)0;
	vso.position = pos;
	vso.position.w = 1;
	vso.uv = uv;
	return vso;
}

float4 PS(VSO vso) : SV_TARGET
{
	uint2  pix  = trunc(vso.position.xy);
	float3 tight = BloomBuf[pix].rgb;   // タイト層（鋭いコロナ）
	float3 wide  = BloomBuf3[pix].rgb;  // ワイド層（光の靄）
	RTOutput[pix] += float4(tight * BLOOM_INTENSITY + wide * BLOOM_WIDE_INTENSITY, 0.0);
	discard;
	return 0;
}

#endif


// ============================================================
// DENOISEパス
// ============================================================
#ifdef YRZ_PASS_DENOISE
struct VSO {
	float4 position:SV_POSITION;
	float2 uv:TEXCOORD;
};

VSO VS( float4 pos : POSITION, float2 uv:TEXCOORD )
{
	VSO vso = (VSO)0;
	vso.position = pos;
	vso.position.w = 1;
	vso.uv = uv;
	return vso;
}

float4 PS(VSO vso) : SV_TARGET
{
	uint2 pix = trunc(vso.position);
	uint  idx = pix.y * Resolution.x + pix.x;
	OIDNBuf[idx].color  = RTOutput[pix.xy].xyz;
	OIDNBuf[idx].albedo = RTOutput[pix.xy].xyz;
	OIDNBuf[idx].normal = float3(0, 0, 1);
	discard;
	return 0;
}
#endif


// ============================================================
// FXAAパス（高品質版）
//   入力: RTOutput（SSAO + デュアルBloom合成済み）を手動バイリニアで読み取り
//   出力: RTOutput（AA結果を上書き）
// ============================================================
#ifdef YRZ_PASS_FXAA

struct VSO {
	float4 position : SV_POSITION;
	float2 uv       : TEXCOORD;
};

VSO VS(float4 pos : POSITION, float2 uv : TEXCOORD)
{
	VSO vso = (VSO)0;
	vso.position = pos;
	vso.position.w = 1;
	vso.uv = uv;
	return vso;
}

float GetLuma(float3 rgb) { return dot(rgb, float3(0.299, 0.587, 0.114)); }

float4 SampleRTO(float2 uv)
{
	float2 fCoord = uv * float2(Resolution) - 0.5;
	int2   iBase  = int2(floor(fCoord));
	float2 fr     = fCoord - float2(iBase);
	int2   bound  = int2(Resolution) - 1;
	float4 tl = RTOutput[clamp(iBase,              int2(0,0), bound)];
	float4 tr = RTOutput[clamp(iBase + int2(1, 0), int2(0,0), bound)];
	float4 bl = RTOutput[clamp(iBase + int2(0, 1), int2(0,0), bound)];
	float4 br = RTOutput[clamp(iBase + int2(1, 1), int2(0,0), bound)];
	return lerp(lerp(tl, tr, fr.x), lerp(bl, br, fr.x), fr.y);
}

float4 PS(VSO vso) : SV_TARGET
{
	uint2  pix      = trunc(vso.position.xy);
	int2   bound    = int2(Resolution) - 1;
	float2 texelSize = 1.0 / float2(Resolution);

	float3 rgbNW = RTOutput[clamp(int2(pix) + int2(-1,-1), int2(0,0), bound)].rgb;
	float3 rgbN  = RTOutput[clamp(int2(pix) + int2( 0,-1), int2(0,0), bound)].rgb;
	float3 rgbNE = RTOutput[clamp(int2(pix) + int2( 1,-1), int2(0,0), bound)].rgb;
	float3 rgbW  = RTOutput[clamp(int2(pix) + int2(-1, 0), int2(0,0), bound)].rgb;
	float3 rgbM  = RTOutput[pix].rgb;
	float3 rgbE  = RTOutput[clamp(int2(pix) + int2( 1, 0), int2(0,0), bound)].rgb;
	float3 rgbSW = RTOutput[clamp(int2(pix) + int2(-1, 1), int2(0,0), bound)].rgb;
	float3 rgbS  = RTOutput[clamp(int2(pix) + int2( 0, 1), int2(0,0), bound)].rgb;
	float3 rgbSE = RTOutput[clamp(int2(pix) + int2( 1, 1), int2(0,0), bound)].rgb;

	float lumaNW = GetLuma(rgbNW), lumaN  = GetLuma(rgbN),  lumaNE = GetLuma(rgbNE);
	float lumaW  = GetLuma(rgbW),  lumaM  = GetLuma(rgbM),  lumaE  = GetLuma(rgbE);
	float lumaSW = GetLuma(rgbSW), lumaS  = GetLuma(rgbS),  lumaSE = GetLuma(rgbSE);

	float lumaMin = min(lumaM, min(min(min(lumaNW, lumaN), min(lumaNE, lumaW)),
	                               min(min(lumaE,  lumaSW), min(lumaS,  lumaSE))));
	float lumaMax = max(lumaM, max(max(max(lumaNW, lumaN), max(lumaNE, lumaW)),
	                               max(max(lumaE,  lumaSW), max(lumaS,  lumaSE))));
	float lumaRange = lumaMax - lumaMin;

	if (lumaRange < max(FXAA_EDGE_THRESHOLD_MIN, lumaMax * FXAA_EDGE_THRESHOLD)) {
		RTOutput[pix] = float4(rgbM, RTOutput[pix].a);
		discard; return 0;
	}

	float lumaAvg = (lumaN + lumaS + lumaW + lumaE) * 0.25
	              + (lumaNW + lumaNE + lumaSW + lumaSE) * 0.125;
	float subpixBlend = saturate(abs(lumaAvg - lumaM) / lumaRange);
	subpixBlend = smoothstep(0.0, 1.0, subpixBlend) * FXAA_SUBPIX_QUALITY;

	float2 dir;
	dir.x = -((lumaNW + lumaNE) - (lumaSW + lumaSE)) - 0.5 * (lumaN - lumaS);
	dir.y =  ((lumaNW + lumaSW) - (lumaNE + lumaSE)) + 0.5 * (lumaW - lumaE);

	float dirReduce = max((lumaNW + lumaNE + lumaSW + lumaSE) * (0.25 * 0.125), 0.0000305);
	float rcpDirMin = 1.0 / (min(abs(dir.x), abs(dir.y)) + dirReduce);
	dir = clamp(dir * rcpDirMin, -FXAA_MAX_SPAN, FXAA_MAX_SPAN) * texelSize;

	float3 rgbA = 0.5 * (
		SampleRTO(vso.uv + dir * (1.0/3.0 - 0.5)).rgb +
		SampleRTO(vso.uv + dir * (2.0/3.0 - 0.5)).rgb);
	float3 rgbB = rgbA * 0.5 + 0.25 * (
		SampleRTO(vso.uv + dir * (0.0/3.0 - 0.5)).rgb +
		SampleRTO(vso.uv + dir * (3.0/3.0 - 0.5)).rgb);

	float  lumaB    = GetLuma(rgbB);
	float3 aaResult = (lumaB < lumaMin || lumaB > lumaMax) ? rgbA : rgbB;

	float3 rgbAvg = (rgbNW + rgbN + rgbNE + rgbW + rgbE + rgbSW + rgbS + rgbSE) * 0.125;
	float3 result = lerp(aaResult, rgbAvg, subpixBlend * 0.25);

	RTOutput[pix] = float4(result, RTOutput[pix].a);
	discard;
	return 0;
}

#endif
