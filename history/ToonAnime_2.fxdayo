/*****************************************************************
  MikuMikuDayo用 アニメ調トゥーンシェーダー ToonAnime_2
  Preview.fxdayo ベース / Subayai.fxdayo 構成参照

  - Diffusion (アニメ風グロー / 分離型ガウスブラー)
  - FXAA (Fast Approximate Anti-Aliasing)
  - セルシェーディング: スムーズステップ影境界 + ハードスペキュラ + リムライト
  - アウトライン: 法線・深度差分エッジ検出

  NVIDIA RTX 5060 向け最適化メモ
    - BrightTex / DiffusionBuf を 0.5x 解像度化しメモリ帯域削減
    - ブルーパスは 7tap 分離型ガウスで ALU / キャッシュ効率優先
    - FP16 RTV (R16G16B16A16_FLOAT) でフレームバッファ帯域削減
    - FXAA ループレス実装でウェーブ占有率を安定化
    - [unroll] でブルーループをコンパイル時展開

  MMXXVI
*****************************************************************/

[YRZFX]
{
    "fx": {
        "cereal_class_version": 0,
        "category": "render",

        "textures": [
            { "name": "ZBuf",          "format": "D32_FLOAT",          "view": "DSV" },
            { "name": "RasterOut",     "format": "R16G16B16A16_FLOAT",  "view": "RTV" },
            { "name": "ToonComp",      "format": "R16G16B16A16_FLOAT",  "view": "RTV" },
            { "name": "MyNormalDepth", "format": "R32G32B32A32_FLOAT",  "view": "RTV" },
            { "name": "MyGBuffer1",    "format": "R32G32B32A32_FLOAT",  "view": "RTV" },
            { "name": "MyGBuffer2",    "format": "R32G32_FLOAT",        "view": "RTV" },
            { "name": "BrightTex",     "format": "R16G16B16A16_FLOAT",  "view": "RTV",
              "size": { "ratio": { "x": 0.5, "y": 0.5 } } },
            { "name": "DiffusionBuf",  "format": "R16G16B16A16_FLOAT",  "view": "RTV",
              "size": { "ratio": { "x": 0.5, "y": 0.5 } } }
        ],

        "samplers": [
            { "name": "samp",       "filter": "ANISOTROPIC" },
            { "name": "ClampSamp",  "filter": "LINEAR",  "addressU": "CLAMP", "addressV": "CLAMP" },
            { "name": "SkySamp",    "filter": "LINEAR",  "addressU": "WRAP",  "addressV": "CLAMP" },
            { "name": "PointSamp",  "filter": "POINT",   "addressU": "BORDER","addressV": "BORDER",
              "borderColor": "TRANSPARENT_BLACK" }
        ],

        "passes": [
            {
                "name": "BG", "type": "postprocess",
                "pixelShader": "PS", "vertexShader": "VS",
                "RTV": [ { "name": "RasterOut", "clear": true, "value": {"x":0,"y":0,"z":0,"w":0} } ]
            },
            {
                "name": "MMD", "type": "rasterizer",
                "vertexShader": "VS", "pixelShader": "PS",
                "DSV": { "name": "ZBuf", "clear": true, "depth": 1.0 },
                "RTV": [ { "name": "RasterOut", "clear": false } ],
                "blendDesc": {
                    "renderTarget0": {
                        "blendEnable": true,
                        "srcBlend": "src_alpha",  "destBlend": "inv_src_alpha",  "blendOp": "add",
                        "srcBlendAlpha": "one",   "destBlendAlpha": "inv_src_alpha", "blendOpAlpha": "add"
                    }
                },
                "rasterizerDesc": { "cullMode": "none" }
            },
            {
                "name": "GBuffer", "type": "rasterizer",
                "vertexShader": "VS", "pixelShader": "PS",
                "DSV": { "name": "ZBuf", "clear": true, "depth": 1.0 },
                "RTV": [
                    { "name": "MyNormalDepth", "clear": true, "value": {"x":0,"y":0,"z":0,"w":0} },
                    { "name": "MyGBuffer1",    "clear": true, "value": {"x":-1,"y":-1,"z":-1,"w":-1} },
                    { "name": "MyGBuffer2",    "clear": true, "value": {"x":0,"y":0,"z":0,"w":0} }
                ],
                "rasterizerDesc": { "cullMode": "none" }
            },
            {
                "name": "Outline", "type": "postprocess",
                "pixelShader": "PS", "vertexShader": "VS",
                "RTV": [ { "name": "ToonComp", "clear": true, "value": {"x":0,"y":0,"z":0,"w":0} } ]
            },
            {
                "name": "BrightExtract", "type": "postprocess",
                "pixelShader": "PS", "vertexShader": "VS",
                "RTV": [ { "name": "BrightTex", "clear": true, "value": {"x":0,"y":0,"z":0,"w":0} } ]
            },
            {
                "name": "DiffusionX", "type": "postprocess",
                "pixelShader": "PS", "vertexShader": "VS",
                "RTV": [ { "name": "DiffusionBuf" } ]
            },
            {
                "name": "DiffusionY", "type": "postprocess",
                "pixelShader": "PS", "vertexShader": "VS",
                "RTV": [ { "name": "RasterOut" } ]
            },
            {
                "name": "FXAA", "type": "postprocess",
                "pixelShader": "PS", "vertexShader": "VS"
            },
            {
                "name": "DENOISE", "type": "postprocess",
                "pixelShader": "PS", "vertexShader": "VS",
                "conditions": [ "DenoiserEnabled" ]
            }
        ]
    }
}

[HLSL]

#include "../hlsl/resources.hlsli"
#include "../hlsl/yrz.hlsli"
using namespace Dayo;
using namespace YRZ;

// Radeon 対策: スカラ変数以外のバインドレステクスチャ添え字に NURI を付ける
#define NURI NonUniformResourceIndex

// ================================================================
//  トゥーンシェーダー パラメータ
// ================================================================

// ---- 影境界 (2トーン) ----
static const float ToonThreshold = 0.0;     // NoL = この値を境に明暗が切り替わる
static const float ToonSoftness  = 0.08;    // 境界のやわらかさ (大きいほどソフト)
static const float3 ShadowTint   = float3(0.50, 0.50, 0.62);  // 影色乗数 (青みがかったアニメ影)

// ---- ハードスペキュラ ----
static const float SpecularStep  = 0.55;    // step 関数の閾値

// ---- リムライト ----
static const float RimPower      = 4.0;     // リム光の鋭さ
static const float RimStrength   = 0.20;    // リム光の強度

// ---- アウトライン ----
static const float OutlineNormThr  = 0.30;  // 法線差分の閾値
static const float OutlineDepthThr = 0.001; // 深度差分の閾値 (正規化済み)
static const float3 OutlineColor   = float3(0.04, 0.02, 0.07); // アウトライン色 (ダークパープル)

// ---- Diffusion (アニメ風ソフトグロー) ----
static const float DiffThreshold  = 0.72;   // グロー抽出の輝度閾値
static const float DiffStrength   = 0.25;   // グロー合成強度
// 7 tap 分離型ガウスカーネル (sigma ≈ 1.6, half-res バッファ上で全解像度 sigma ≈ 3.2 相当)
static const int   DIFF_TAPS      = 7;
static const float DIFF_OFF[7]    = { -3.0, -2.0, -1.0,  0.0,  1.0,  2.0,  3.0 };
static const float DIFF_W[7]      = {0.0625, 0.125, 0.1875, 0.25, 0.1875, 0.125, 0.0625};

// ---- FXAA ----
static const float FXAA_SPAN_MAX   = 8.0;
static const float FXAA_REDUCE_MUL = 1.0 / 8.0;
static const float FXAA_REDUCE_MIN = 1.0 / 128.0;

// ================================================================
//  共有ユーティリティ (全パスで使用)
// ================================================================

// カメラレイ方向を UV から計算 (Preview.fxdayo 準拠)
void RaySaySay(float2 Tex, out float3 ray, out float3 pos, uniform bool doNormalize = true)
{
    float2 tex = (Tex - 0.5) * 2.0;
    if (Perspective) {
        ray = ViewMatrix._13_23_33 / ProjectionMatrix._33
            + (ViewMatrix._11_21_31 * tex.x / ProjectionMatrix._11)
            - (ViewMatrix._12_22_32 * tex.y / ProjectionMatrix._22);
        if (doNormalize)
            ray = normalize(ray);
        pos = CameraPosition;
    } else {
        ray = CameraForward;
        pos = CameraPosition
            + CameraRight * tex.x / ProjectionMatrix._11
            - CameraUp    * tex.y / ProjectionMatrix._22;
    }
}

// 球面 UV 変換
float2 LongRat(float3 v)
{
    return float2(atan2(v.z, v.x), acos(v.y)) / float2(-2.0 * PI, PI) - float2(0.25, 0.0);
}

// ================================================================
//  BG パス — Skybox 描画
// ================================================================
#ifdef YRZ_PASS_BG
struct VSO { float4 position : SV_POSITION; float2 uv : TEXCOORD; };

VSO VS(float4 pos : POSITION, float2 uv : TEXCOORD)
{
    VSO vso = (VSO)0;
    vso.position = pos;
    vso.position.w = 1;
    vso.uv = uv;
    return vso;
}

float4 PS(VSO vso) : SV_TARGET
{
    float3 rd, ro;
    RaySaySay(vso.uv, rd, ro);
    float4 sky = Skybox.SampleLevel(SkySamp, LongRat(rd), 0);
    return float4(sky.rgb, 0); // 背景部分は α=0
}
#endif


// ================================================================
//  MMD パス & GBuffer パス (共有 VS / PS)
// ================================================================
#if defined(YRZ_PASS_MMD) || defined(YRZ_PASS_GBuffer)
struct VSO {
    float4 position : SV_POSITION;
    float3 normal   : NORMAL;
    float2 uv       : TEXCOORD;
    float2 spuv     : TEXCOORD1;
    float3 eye      : TEXCOORD2;
};

VSO VS(float4 pos : POSITION, float3 normal : NORMAL, float3 tangent : TANGENT, float2 uv : TEXCOORD,
       float4 exuv1 : TEXCOORD1, float4 exuv2 : TEXCOORD2,
       float4 exuv3 : TEXCOORD3, float4 exuv4 : TEXCOORD4)
{
    VSO o = (VSO)0;
    o.position = mul(pos, ViewProjectionMatrix);
    o.uv       = uv;
    o.spuv     = mul(normal, (float3x2)ViewMatrix) * float2(0.5, -0.5) + 0.5;
    o.normal   = normal;
    o.eye      = CameraPosition - pos.xyz;
    return o;
}

// ----------------------------------------------------------------
//  アニメ調トゥーンシェーディング関数
// ----------------------------------------------------------------
float4 ToonColor(VSO vso, uint iFace, bool vface)
{
    uint imo = ModelIndex;
    MMDMaterial m = MMDMaterials[imo][Faces[imo][iFace]];

    // 片面描画材質の裏面スキップ
    if (!vface && ((m.drawFlag & 1) == 0))
        discard;

    float3 N  = normalize(vso.normal);
    if (!vface) N = -N;               // 裏面なら法線反転
    float3 V  = normalize(vso.eye);
    float3 L  = -LightDirection;
    float3 H  = normalize(L + V);
    float3 Le = LightColor;

    float NoL = dot(N, L);
    float NoV = saturate(dot(N, V));
    float NoH = saturate(dot(N, H));

    uint tidx = TextureTable[imo];

    // ----- テクスチャ -----
    float4 tex = 1;
    if (m.tex >= 0) {
        tex     = Textures[NURI(tidx + m.tex)].Sample(samp, vso.uv);
        tex.rgb = lerp(1, tex.rgb * m.textureMulValue.rgb + m.textureAddValue.rgb,
                       m.textureMulValue.a + m.textureAddValue.a);
    }

    // ----- ベースカラー (Diffuse + Ambient) -----
    float4 o = float4(saturate(m.diffuse.rgb * Le + m.ambient), m.diffuse.a) * tex;

    // ----- トゥーン影 -----
    if (m.toonFlag == 0 && m.toonTex >= 0) {
        // MMD トゥーンテクスチャを優先使用
        float2 toonUV = float2(0, 0.5 - NoL * 0.5);
        o *= Textures[NURI(tidx + m.toonTex)].Sample(ClampSamp, toonUV);
    } else if (m.toonFlag == 1) {
        // 共有 Toon 代替: smoothstep による 2 トーン + 影色乗数
        float lit = smoothstep(ToonThreshold - ToonSoftness,
                               ToonThreshold + ToonSoftness, NoL);
        o.rgb *= lerp(ShadowTint, 1.0, lit);
    } else {
        // Toon テクスチャなし: シンプルな 2 トーン
        float lit = smoothstep(ToonThreshold - ToonSoftness,
                               ToonThreshold + ToonSoftness, NoL);
        o.rgb *= lerp(ShadowTint, 1.0, lit);
    }

    // ----- スフィアマップ -----
    if (m.spTex >= 0 && (m.spmode == 1 || m.spmode == 2)) {
        float4 sp = Textures[NURI(tidx + m.spTex)].Sample(samp, vso.spuv);
        sp.rgb    = lerp(m.spmode == 1 ? 1.0 : 0.0,
                         sp.rgb * m.sphereMulValue.rgb + m.sphereAddValue.rgb,
                         m.sphereAddValue.a + m.sphereMulValue.a);
        o.rgb = (m.spmode == 1) ? o.rgb * sp.rgb : o.rgb + sp.rgb;
        o.a  *= sp.a;
    }

    // ----- ハードエッジスペキュラ (アニメらしいクッキリ光沢) -----
    float rawSpec = pow(max(1e-6, NoH), max(1.0, m.shininess));
    float hardSpec = step(SpecularStep, rawSpec);
    o.rgb += m.specular * Le * hardSpec;

    // ----- リムライト (輪郭に沿った光) -----
    // 光に向いた面のみリムを乗せる (影側のリムはキャンセル)
    float rim = pow(1.0 - NoV, RimPower) * saturate(NoL + 0.4);
    o.rgb += Le * RimStrength * rim;

    // ----- アルファ処理 -----
    if (o.a == 0)
        discard;
    if (o.a >= 0.98)
        o.a = 1;

    o.rgb = ToLinear(o.rgb);
    return o;
}

// ---- MMD パス: トゥーン描画 → RasterOut ----
#ifdef YRZ_PASS_MMD
float4 PS(VSO vso, uint iFace : SV_PrimitiveID, bool vface : SV_IsFrontFace) : SV_TARGET
{
    return ToonColor(vso, iFace, vface);
}
#endif

// ---- GBuffer パス: 法線/深度/モデルインデックスを保存 ----
#ifdef YRZ_PASS_GBuffer
struct GBPSO {
    float4 NormalDepth : SV_TARGET0;
    float4 GBuffer1    : SV_TARGET1;
    float2 GBuffer2    : SV_TARGET2;
};

#ifndef NO_BARYCENTRICS
GBPSO PS(VSO vso, uint iFace : SV_PrimitiveID, bool vface : SV_IsFrontFace, float3 bary : SV_Barycentrics)
#else
GBPSO PS(VSO vso, uint iFace : SV_PrimitiveID, bool vface : SV_IsFrontFace)
#endif
{
    float4 c = ToonColor(vso, iFace, vface);
    if (c.a < AlphaThreshold)
        discard;

    GBPSO o = (GBPSO)0;
    o.NormalDepth = float4(vso.normal, vso.position.w);

    // float32 の 24 bit 精度を活用してモデル/フェース番号をパック
    o.GBuffer1.r = ModelIndex & 0x00FFFFFF;
    o.GBuffer1.g = ModelIndex >> 24;
    o.GBuffer1.b = iFace & 0x00FFFFFF;
    o.GBuffer1.a = iFace >> 24;

#ifndef NO_BARYCENTRICS
    o.GBuffer2 = bary.yz;
#else
    o.GBuffer2 = float2(0, 0);
#endif
    return o;
}
#endif // YRZ_PASS_GBuffer

#endif // MMD || GBuffer


// ================================================================
//  Outline パス — エッジ検出 + アウトライン合成 → ToonComp
// ================================================================
#ifdef YRZ_PASS_Outline
struct VSO { float4 position : SV_POSITION; float2 uv : TEXCOORD; };

VSO VS(float4 pos : POSITION, float2 uv : TEXCOORD)
{
    VSO vso = (VSO)0; vso.position = pos; vso.position.w = 1; vso.uv = uv; return vso;
}

// 4 近傍サンプルによる法線・深度差分エッジ検出
float EdgeDetect(float2 uv)
{
    float2 t = 1.0 / Resolution;
    float4 C  = MyNormalDepth.SampleLevel(PointSamp, uv,                        0);
    float4 R  = MyNormalDepth.SampleLevel(PointSamp, uv + float2( t.x,  0), 0);
    float4 L  = MyNormalDepth.SampleLevel(PointSamp, uv + float2(-t.x,  0), 0);
    float4 D  = MyNormalDepth.SampleLevel(PointSamp, uv + float2( 0,  t.y), 0);
    float4 U  = MyNormalDepth.SampleLevel(PointSamp, uv + float2( 0, -t.y), 0);

    // 法線差分 (0..4 の範囲になる)
    float nEdge = length(R.xyz - C.xyz) + length(L.xyz - C.xyz)
                + length(D.xyz - C.xyz) + length(U.xyz - C.xyz);

    // 正規化深度差分
    float refDepth = max(C.w, 1e-4);
    float dEdge = (abs(R.w - C.w) + abs(L.w - C.w)
                 + abs(D.w - C.w) + abs(U.w - C.w)) / refDepth;

    float e = saturate(step(OutlineNormThr, nEdge) + step(OutlineDepthThr, dEdge));

    // ジオメトリが存在するピクセルのみアウトライン対象とする
    return e * step(1e-4, C.w);
}

float4 PS(VSO vso) : SV_TARGET
{
    float4 color = RasterOut.SampleLevel(ClampSamp, vso.uv, 0);
    float  edge  = EdgeDetect(vso.uv);
    color.rgb    = lerp(color.rgb, OutlineColor, edge);
    return color;
}
#endif


// ================================================================
//  BrightExtract パス — グロー対象輝度抽出 → BrightTex (half-res)
// ================================================================
#ifdef YRZ_PASS_BrightExtract
struct VSO { float4 position : SV_POSITION; float2 uv : TEXCOORD; };

VSO VS(float4 pos : POSITION, float2 uv : TEXCOORD)
{
    VSO vso = (VSO)0; vso.position = pos; vso.position.w = 1; vso.uv = uv; return vso;
}

float4 PS(VSO vso) : SV_TARGET
{
    float3 c    = ToonComp.SampleLevel(ClampSamp, vso.uv, 0).rgb;
    float  luma = RGBtoY(c);

    // Soft knee: 閾値付近をなめらかに
    float bright = saturate((luma - DiffThreshold) / max(1.0 - DiffThreshold, 1e-5));
    bright       = bright * bright;    // 2次カーブで締まりを出す

    return float4(c * bright, 1.0);
}
#endif


// ================================================================
//  DiffusionX パス — 水平ガウスブラー (BrightTex → DiffusionBuf)
// ================================================================
#ifdef YRZ_PASS_DiffusionX
struct VSO { float4 position : SV_POSITION; float2 uv : TEXCOORD; };

VSO VS(float4 pos : POSITION, float2 uv : TEXCOORD)
{
    VSO vso = (VSO)0; vso.position = pos; vso.position.w = 1; vso.uv = uv; return vso;
}

float4 PS(VSO vso) : SV_TARGET
{
    // half-res テクスチャ上での 1 テクセル = フル解像度 2 テクセル相当
    float2 dir = float2(1.0 / Resolution.x, 0.0) * 2.0;

    float3 acc = 0;
    [unroll]
    for (int i = 0; i < DIFF_TAPS; i++)
        acc += BrightTex.SampleLevel(ClampSamp, vso.uv + dir * DIFF_OFF[i], 0).rgb * DIFF_W[i];

    return float4(acc, 1.0);
}
#endif


// ================================================================
//  DiffusionY パス — 垂直ガウスブラー + ToonComp と合成 → RasterOut
//  ※ DiffusionBuf を読み、ToonComp に Diffusion を重ねて RasterOut へ出力
// ================================================================
#ifdef YRZ_PASS_DiffusionY
struct VSO { float4 position : SV_POSITION; float2 uv : TEXCOORD; };

VSO VS(float4 pos : POSITION, float2 uv : TEXCOORD)
{
    VSO vso = (VSO)0; vso.position = pos; vso.position.w = 1; vso.uv = uv; return vso;
}

float4 PS(VSO vso) : SV_TARGET
{
    float2 dir = float2(0.0, 1.0 / Resolution.y) * 2.0;

    float3 bloom = 0;
    [unroll]
    for (int i = 0; i < DIFF_TAPS; i++)
        bloom += DiffusionBuf.SampleLevel(ClampSamp, vso.uv + dir * DIFF_OFF[i], 0).rgb * DIFF_W[i];

    float4 base = ToonComp.SampleLevel(ClampSamp, vso.uv, 0);
    // アニメらしい淡い輝き: 加算合成
    base.rgb += bloom * DiffStrength;
    return base;
}
#endif


// ================================================================
//  FXAA パス — 最終アンチエイリアス → RTOutput
//  Timothy Lottes FXAA 3.11 ベース実装
//  + GBuffer/NormalDepth を永続バッファへコピー (Preview.fxdayo Copy パス相当)
// ================================================================
#ifdef YRZ_PASS_FXAA
struct VSO { float4 position : SV_POSITION; float2 uv : TEXCOORD; };

VSO VS(float4 pos : POSITION, float2 uv : TEXCOORD)
{
    VSO vso = (VSO)0; vso.position = pos; vso.position.w = 1; vso.uv = uv; return vso;
}

// FXAA コア (RasterOut を読む。Diffusion 合成済み)
float3 ApplyFXAA(float2 uv)
{
    float2 rcpRes = 1.0 / Resolution;

    float3 rgbNW = RasterOut.SampleLevel(ClampSamp, uv + float2(-1, -1) * rcpRes, 0).rgb;
    float3 rgbNE = RasterOut.SampleLevel(ClampSamp, uv + float2( 1, -1) * rcpRes, 0).rgb;
    float3 rgbSW = RasterOut.SampleLevel(ClampSamp, uv + float2(-1,  1) * rcpRes, 0).rgb;
    float3 rgbSE = RasterOut.SampleLevel(ClampSamp, uv + float2( 1,  1) * rcpRes, 0).rgb;
    float3 rgbM  = RasterOut.SampleLevel(ClampSamp, uv,                  0).rgb;

    float lumaNW = RGBtoY(rgbNW);
    float lumaNE = RGBtoY(rgbNE);
    float lumaSW = RGBtoY(rgbSW);
    float lumaSE = RGBtoY(rgbSE);
    float lumaM  = RGBtoY(rgbM);

    float lumaMin = min(lumaM, min(min(lumaNW, lumaNE), min(lumaSW, lumaSE)));
    float lumaMax = max(lumaM, max(max(lumaNW, lumaNE), max(lumaSW, lumaSE)));

    // エッジが弱いピクセルは早期リターン (RTX ウェーブ占有率最適化)
    float lumaRange = lumaMax - lumaMin;
    if (lumaRange < max(FXAA_REDUCE_MIN, lumaMax * 0.25))
        return rgbM;

    // エッジ方向を推定
    float2 dir;
    dir.x = -((lumaNW + lumaNE) - (lumaSW + lumaSE));
    dir.y =  ((lumaNW + lumaSW) - (lumaNE + lumaSE));

    float dirReduce = max((lumaNW + lumaNE + lumaSW + lumaSE) * (0.25 * FXAA_REDUCE_MUL),
                          FXAA_REDUCE_MIN);
    float rcpDirMin = 1.0 / (min(abs(dir.x), abs(dir.y)) + dirReduce);
    dir = clamp(dir * rcpDirMin, -FXAA_SPAN_MAX, FXAA_SPAN_MAX) * rcpRes;

    // 2 段サンプリングでサブピクセルブレンド量を決定
    float3 rgbA = 0.5 * (
        RasterOut.SampleLevel(ClampSamp, uv + dir * (1.0/3.0 - 0.5), 0).rgb +
        RasterOut.SampleLevel(ClampSamp, uv + dir * (2.0/3.0 - 0.5), 0).rgb);
    float3 rgbB = 0.5 * rgbA + 0.25 * (
        RasterOut.SampleLevel(ClampSamp, uv + dir * -0.5, 0).rgb +
        RasterOut.SampleLevel(ClampSamp, uv + dir *  0.5, 0).rgb);

    float lumaB = RGBtoY(rgbB);
    return ((lumaB < lumaMin) || (lumaB > lumaMax)) ? rgbA : rgbB;
}

float4 PS(VSO vso) : SV_TARGET
{
    uint2  pix = (uint2)trunc(vso.position.xy);
    float2 uv  = vso.position.xy / Resolution;

    // FXAA 適用して RTOutput へ書き込み
    float4 src = RasterOut.SampleLevel(ClampSamp, uv, 0);
    RTOutput[pix] = float4(ApplyFXAA(uv), src.a);

    // GBuffer / NormalDepth を永続バッファへコピー (Subayai の CopyNDG 相当)
    float4 G1 = MyGBuffer1[pix];
    GBuffer1[pix].r = (G1.r < 0) ? -1 : (uint)G1.r | ((uint)G1.g << 24);
    GBuffer1[pix].g = (G1.b < 0) ? -1 : (uint)G1.b | ((uint)G1.a << 24);
    GBuffer2[pix]   = MyGBuffer2[pix];
    NormalDepth[pix] = MyNormalDepth[pix];

    discard;
    return 0;
}
#endif


// ================================================================
//  DENOISE パス — OIDN 入力バッファ作成 (Preview.fxdayo 準拠)
// ================================================================
#ifdef YRZ_PASS_DENOISE
struct VSO { float4 position : SV_POSITION; float2 uv : TEXCOORD; };

VSO VS(float4 pos : POSITION, float2 uv : TEXCOORD)
{
    VSO vso = (VSO)0; vso.position = pos; vso.position.w = 1; vso.uv = uv; return vso;
}

float4 PS(VSO vso) : SV_TARGET
{
    uint2 pix = (uint2)trunc(vso.position);
    uint  idx = pix.y * (uint)Resolution.x + pix.x;

    OIDNBuf[idx].color  = RTOutput[pix].xyz;
    OIDNBuf[idx].albedo = RTOutput[pix].xyz;
    OIDNBuf[idx].normal = NormalDepth[pix].xyz;

    discard;
    return 0;
}
#endif
