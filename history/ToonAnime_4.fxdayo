[YRZFX]
{
    "fx": {
        "cereal_class_version": 0,
        "category": "render",
		"textures" : [
			{"name": "ZBuf", "format": "D32_FLOAT", "view": "DSV" },
			{"name": "RasterOut", "format": "R16G16B16A16_FLOAT", "view":"RTV" },
			{"name": "MyNormalDepth", "format": "R32G32B32A32_FLOAT", "view":"RTV"},
			{"name": "MyGBuffer1", "format": "R32G32B32A32_FLOAT", "view":"RTV"},
			{"name": "MyGBuffer2", "format": "R32G32_FLOAT", "view":"RTV"},
		],
		"samplers" : [
			{ "name":"samp", "filter":"ANISOTROPIC" },
			{ "name":"ClampSamp", "filter":"LINEAR", "addressU":"CLAMP", "addressV":"CLAMP" },
			{ "name":"SkySamp", "filter":"LINEAR", "addressU":"WRAP", "addressV":"CLAMP" }
		],
        "passes": [
			{
				"name":"BG", "type":"postprocess",
				"pixelShader": "PS", "vertexShader": "VS",
				"RTV": [ {"name":"RasterOut", "clear":true, "value":{"x":0, "y":0, "z":0, "w":0} }]
			},
			{
				"name": "MMD",
				"type": "rasterizer", "vertexShader": "VS", "pixelShader": "PS",
                "DSV": { "name": "ZBuf", "clear": true, "depth": 1.0 },
				"RTV": [{ "name": "RasterOut", "clear":false }],
                "blendDesc": {
                    "renderTarget0": {
                        "blendEnable": true,
						"srcBlend": "src_alpha", "destBlend": "inv_src_alpha", "blendOp": "add",
                        "srcBlendAlpha": "one", "destBlendAlpha": "inv_src_alpha", "blendOpAlpha": "add"
                    }
                },
                "rasterizerDesc": { "cullMode": "none"}
            },
			{
				"name": "GBuffer",
				"type": "rasterizer", "vertexShader": "VS", "pixelShader": "PS",
                "DSV": { "name": "ZBuf", "clear": true, "depth": 1.0 },
				"RTV": [
					{ "name": "MyNormalDepth", "clear":true, "value":{"x":0, "y":0, "z":0, "w":0} },
					{ "name": "MyGBuffer1", "clear":true, "value":{"x":-1, "y":-1, "z":-1, "w":-1} },
					{ "name": "MyGBuffer2", "clear":true, "value":{"x":0, "y":0, "z":0, "w":0} }
				],
                "rasterizerDesc": { "cullMode": "none"}
            },
			{"name":"Copy",  "type":"postprocess", "pixelShader": "PS", "vertexShader": "VS"},
			{"name":"FXAA",  "type":"postprocess", "pixelShader": "PS", "vertexShader": "VS"},
			{"name":"DENOISE","type":"postprocess", "pixelShader": "PS", "vertexShader": "VS", "conditions":["DenoiserEnabled"]},
        ]
    }
}
[HLSL]

#include "../hlsl/resources.hlsli"
#include "../hlsl/yrz.hlsli"
using namespace Dayo;
using namespace YRZ;

#define NURI NonUniformResourceIndex

// ===========================================================
// BG パス: スカイボックス描画
// ===========================================================
#ifdef YRZ_PASS_BG
struct VSO {
	float4 position:SV_POSITION;
	float2 uv:TEXCOORD;
};

VSO VS( float4 pos : POSITION, float2 uv:TEXCOORD )
{
	VSO vso = (VSO)0;
	vso.position = pos;
	vso.position.w = 1;
	vso.uv = uv;
	return vso;
}

void RaySaySay(float2 Tex, out float3 ray, out float3 pos, uniform bool normalizeFlag = true)
{
	float2 tex = (Tex.xy - 0.5) * 2.0;
	if (Perspective) {
		ray =
			ViewMatrix._13_23_33 / ProjectionMatrix._33
			+ (ViewMatrix._11_21_31 * tex.x / ProjectionMatrix._11)
			- (ViewMatrix._12_22_32 * tex.y / ProjectionMatrix._22);
		if (normalizeFlag)
			ray = normalize(ray);
		pos = CameraPosition;
	} else {
		ray = CameraForward;
		pos = CameraPosition + CameraRight * tex.x / ProjectionMatrix._11 - CameraUp * tex.y / ProjectionMatrix._22;
	}
}

static float SkyboxPhi = 0;

float2 LongRat(float3 v)
{
	return float2(atan2(v.z, v.x), acos(v.y)) / float2(-2 * PI, PI) - float2(0.25 + SkyboxPhi, 0);
}

float4 PS(VSO vso) : SV_TARGET
{
	float4 o = 0;
	float3 rd, ro;
	RaySaySay(vso.uv, rd, ro);
	o = Skybox.SampleLevel(SkySamp, LongRat(rd), 0);
	return float4(o.rgb, 0);
}
#endif


// ===========================================================
// MMD/GBuffer パス: モデル描画 + 彩度ブースト
// ===========================================================
#if defined(YRZ_PASS_MMD) || defined(YRZ_PASS_GBuffer)
struct VSO {
	float4 position:SV_POSITION;
	float3 normal:NORMAL;
	float2 uv:TEXCOORD;
	float2 spuv:TEXCOORD1;
	float3 eye:TEXCOORD2;
};

VSO VS( float4 pos : POSITION, float3 normal:NORMAL, float3 tangent:TANGENT, float2 uv:TEXCOORD)
{
	VSO o = (VSO)0;
	o.position = mul(pos, ViewProjectionMatrix);
	o.uv = uv;
	o.spuv = mul(normal, (float3x2)ViewMatrix) * float2(0.5, -0.5) + 0.5;
	o.normal = normal;
	o.eye = CameraPosition - pos.xyz;
	return o;
}

// ---------------------------------------------------------
// アニメ調彩度ブースト (ToonAnime_4)
// 1.0 = 変更なし、値を大きくするほど鮮やか
// ---------------------------------------------------------
static const float ToonSaturationBoost = 1.8;

float4 MMDColor(VSO vso, uint iFace, bool vface)
{
	uint imo = ModelIndex;
	MMDMaterial m = MMDMaterials[imo][Faces[imo][iFace]];

	if (!vface && ((m.drawFlag & 1) == 0))
		discard;

	float4 o;
	float3 Le = LightColor;
	float3 L  = -LightDirection;
	float3 N  = vso.normal;
	float3 V  = normalize(vso.eye);
	float3 H  = normalize(L + V);
	float  NoL = dot(N, L);
	uint tidx = TextureTable[imo];

	float4 tex = 1;
	if (m.tex >= 0) {
		tex = Textures[NURI(tidx + m.tex)].Sample(samp, vso.uv);
		tex.rgb = lerp(1, tex.rgb * m.textureMulValue.rgb + m.textureAddValue.rgb,
		               m.textureMulValue.a + m.textureAddValue.a);
	}

	o = float4(saturate(m.diffuse.rgb * Le + m.ambient), m.diffuse.a) * tex;

	if (m.toonFlag == 0 && m.toonTex >= 0) {
		o *= Textures[NURI(tidx + m.toonTex)].Sample(ClampSamp, float2(0, 0.5 - NoL * 0.5));
	} else if (m.toonFlag == 1) {
		o.rgb *= lerp(0.5, 1, smoothstep(-0.1, 0.1, NoL));
	}

	if (m.spTex >= 0 && (m.spmode == 1 || m.spmode == 2)) {
		float4 sptex = Textures[NURI(tidx + m.spTex)].Sample(samp, vso.spuv);
		sptex.rgb = lerp(m.spmode == 1 ? 1 : 0,
		                 sptex.rgb * m.sphereMulValue.rgb + m.sphereAddValue.rgb,
		                 m.sphereAddValue.a + m.sphereMulValue.a);
		o.rgb = (m.spmode == 1) ? o.rgb * sptex.rgb : o.rgb + sptex.rgb;
		o.a  *= sptex.a;
	}

	o.rgb += m.specular * Le * pow(max(1e-6, dot(N, H)), m.shininess);

	if (o.a == 0) discard;
	if (o.a >= 0.98) o.a = 1;

	// 彩度ブースト: ガンマ空間でToLinear前に適用
	float luma = dot(o.rgb, float3(0.299, 0.587, 0.114));
	o.rgb = saturate(lerp(float3(luma, luma, luma), o.rgb, ToonSaturationBoost));

	o.rgb = ToLinear(o.rgb);
	return o;
}

	#ifdef YRZ_PASS_MMD
		float4 PS(VSO vso, uint iFace:SV_PrimitiveID, bool vface:SV_IsFrontFace) : SV_TARGET
		{
			return MMDColor(vso, iFace, vface);
		}
	#else
		struct PSO {
			float4 NormalDepth : SV_TARGET0;
			float4 GBuffer1    : SV_TARGET1;
			float2 GBuffer2    : SV_TARGET2;
		};

		#ifndef NO_BARYCENTRICS
		PSO PS(VSO vso, uint iFace:SV_PrimitiveID, bool vface:SV_IsFrontFace, float3 bary:SV_Barycentrics) {
		#else
		PSO PS(VSO vso, uint iFace:SV_PrimitiveID, bool vface:SV_IsFrontFace) {
			float3 bary = 0;
		#endif
			float4 c = MMDColor(vso, iFace, vface);
			if (c.a < AlphaThreshold) discard;
			PSO o = (PSO)0;
			o.NormalDepth = float4(vso.normal, vso.position.w);
			o.GBuffer1.r = ModelIndex & 0x00FFFFFF;
			o.GBuffer1.g = ModelIndex >> 24;
			o.GBuffer1.b = iFace & 0x00FFFFFF;
			o.GBuffer1.a = iFace >> 24;
			o.GBuffer2   = bary.yz;
			return o;
		}
	#endif
#endif


// ===========================================================
// Copy パス: 細輪郭線 + Diffusion(ブルーム) → RTOutput 書き込み
//
// ◆ 設計メモ
//   エッジを独立パスのblendDescで描くと全黒バグが出るため
//   UAV直書きのCopyパス内で処理する。
//   Diffusionも同様に、エッジ前のRasterOutを入力とすることで
//   黒いエッジがブルームに混入しないよう設計。
// ===========================================================
#ifdef YRZ_PASS_Copy

// ---- 輪郭パラメータ ----
// モデル側1ピクセルのみ(背景側なし)で細い輪郭を実現
static const float3 ToonOutlineColor          = float3(0.0, 0.0, 0.0);
static const float  ToonOutlineAlpha          = 0.90;
static const float  ToonNormalEdgeSensitivity = 0.35;  // 大きいほど線が細くなる
static const float  ToonDepthEdgeSensitivity  = 0.10;

// ---- Diffusion(ブルーム発光)パラメータ ----
static const float DiffThreshold = 0.75;  // この輝度を超える部分が発光 (0〜1)
static const float DiffStrength  = 0.35;  // 発光の強さ
static const float DiffSigma2    = 6.0;   // ガウス分散 (大きいほど広く柔らかい)

struct VSO {
	float4 position:SV_POSITION;
	float2 uv:TEXCOORD;
};

VSO VS( float4 pos : POSITION, float2 uv:TEXCOORD )
{
	VSO vso = (VSO)0;
	vso.position = pos;
	vso.position.w = 1;
	vso.uv = uv;
	return vso;
}

float4 PS(VSO vso) : SV_TARGET
{
	uint2 pix = trunc(vso.position.xy);
	int2  res = int2((int)Resolution.x, (int)Resolution.y);

	// ---- 細輪郭線検出 (モデル側1ピクセルのみ) ----
	float4 nd_c = MyNormalDepth[pix];
	float4 nd_r = MyNormalDepth[pix + uint2(1, 0)];
	float4 nd_l = MyNormalDepth[uint2(max((int)pix.x - 1, 0), pix.y)];
	float4 nd_u = MyNormalDepth[pix + uint2(0, 1)];
	float4 nd_d = MyNormalDepth[uint2(pix.x, max((int)pix.y - 1, 0))];

	bool isModel   = nd_c.w > 0.0;
	bool isModel_r = nd_r.w > 0.0;
	bool isModel_l = nd_l.w > 0.0;
	bool isModel_u = nd_u.w > 0.0;
	bool isModel_d = nd_d.w > 0.0;

	// シルエット: モデル側のみ (1ピクセル幅)
	// 背景側(`!isModel && adjacent`)は含めないことで細く仕上げる
	float silhouette = 0.0;
	if (isModel && (!isModel_r || !isModel_l || !isModel_u || !isModel_d))
		silhouette = 1.0;

	// 法線不連続エッジ (閾値を上げて細く)
	float normalEdge = 0.0;
	if (isModel) {
		float3 diffH = nd_r.xyz - nd_l.xyz;
		float3 diffV = nd_u.xyz - nd_d.xyz;
		normalEdge = step(ToonNormalEdgeSensitivity, length(diffH) + length(diffV));
	}

	// 深度不連続エッジ (閾値を上げて細く)
	float depthEdge = 0.0;
	if (isModel && nd_c.w > 1e-4) {
		float dH = abs(nd_r.w - nd_l.w);
		float dV = abs(nd_u.w - nd_d.w);
		depthEdge = step(ToonDepthEdgeSensitivity, (dH + dV) / nd_c.w);
	}

	float edge = saturate(silhouette + normalEdge + depthEdge);

	// ---- Diffusion: 7x7 Gaussianブルーム ----
	// RasterOut (エッジ前) を参照するのでエッジ色が発光に混入しない
	float3 bloomColor = 0;
	float  bloomExW   = 0;

	for (int dy = -3; dy <= 3; dy++) {
		for (int dx = -3; dx <= 3; dx++) {
			float w = exp(-(float(dx * dx + dy * dy)) / DiffSigma2);
			int2  sp = clamp(int2(pix) + int2(dx, dy), int2(0, 0), res - 1);
			float3 s = RasterOut[uint2(sp)].rgb;
			float lum = dot(s, float3(0.299, 0.587, 0.114));
			float excess = max(0.0, lum - DiffThreshold);
			bloomColor += s * (excess * w);
			bloomExW   += excess * w;
		}
	}
	// 正規化: ブルーム色の加重平均 × 強度
	float3 diffusion = (bloomExW > 1e-6)
	                 ? (bloomColor / bloomExW) * DiffStrength
	                 : float3(0, 0, 0);

	// ---- 合成: ベース + ブルーム → エッジ上書き ----
	float4 base = RasterOut[pix];
	float3 combined = saturate(base.rgb + diffusion);
	combined = lerp(combined, ToonOutlineColor, edge * ToonOutlineAlpha);

	RTOutput[pix] = float4(combined, base.a);

	// ---- GBuffer コピー ----
	float4 G1 = MyGBuffer1[pix];
	GBuffer1[pix].r = (G1.r < 0) ? -1 : (uint)G1.r | ((uint)G1.g << 24);
	GBuffer1[pix].g = (G1.b < 0) ? -1 : (uint)G1.b | ((uint)G1.a << 24);
	GBuffer2[pix]    = MyGBuffer2[pix];
	NormalDepth[pix] = MyNormalDepth[pix];

	discard;
	return 0;
}
#endif


// ===========================================================
// FXAA パス: アンチエイリアス
//
// Copy後のRTOutput(エッジ込み)を読み書きするため
// エッジ含む全体のジャギーが緩和される。
// RTOutput を同一パス内で読み書きするが、各ピクセルが
// 自身の座標にのみ書き込むため実用上の問題はない。
// ===========================================================
#ifdef YRZ_PASS_FXAA

// ---- FXAA パラメータ ----
static const float FxaaSubpix         = 0.75;   // サブピクセルAAの強さ (0〜1)
static const float FxaaEdgeThreshold  = 0.166;  // エッジ判定の輝度差閾値
static const float FxaaEdgeThreshMin  = 0.0833; // 暗部でのエッジ判定下限

struct VSO {
	float4 position:SV_POSITION;
	float2 uv:TEXCOORD;
};

VSO VS( float4 pos : POSITION, float2 uv:TEXCOORD )
{
	VSO vso = (VSO)0;
	vso.position = pos;
	vso.position.w = 1;
	vso.uv = uv;
	return vso;
}

float4 PS(VSO vso) : SV_TARGET
{
	uint2 pix = trunc(vso.position.xy);

	// 3x3 近傍を読み込み
	float4 cM  = RTOutput[pix];
	float4 cN  = RTOutput[pix + int2( 0,  1)];
	float4 cS  = RTOutput[pix + int2( 0, -1)];
	float4 cE  = RTOutput[pix + int2( 1,  0)];
	float4 cW  = RTOutput[pix + int2(-1,  0)];
	float4 cNE = RTOutput[pix + int2( 1,  1)];
	float4 cNW = RTOutput[pix + int2(-1,  1)];
	float4 cSE = RTOutput[pix + int2( 1, -1)];
	float4 cSW = RTOutput[pix + int2(-1, -1)];

	// 輝度 (luma) を計算
	static const float3 LumaVec = float3(0.299, 0.587, 0.114);
	float lumaM  = dot(cM.rgb,  LumaVec);
	float lumaN  = dot(cN.rgb,  LumaVec);
	float lumaS  = dot(cS.rgb,  LumaVec);
	float lumaE  = dot(cE.rgb,  LumaVec);
	float lumaW  = dot(cW.rgb,  LumaVec);
	float lumaNE = dot(cNE.rgb, LumaVec);
	float lumaNW = dot(cNW.rgb, LumaVec);
	float lumaSE = dot(cSE.rgb, LumaVec);
	float lumaSW = dot(cSW.rgb, LumaVec);

	float lumaMax   = max(max(lumaM, lumaN), max(max(lumaS, lumaE), lumaW));
	float lumaMin   = min(min(lumaM, lumaN), min(min(lumaS, lumaE), lumaW));
	float lumaRange = lumaMax - lumaMin;

	// エッジ判定: 輝度差が閾値以下ならAAスキップ (RTOutputをそのまま維持)
	if (lumaRange < max(FxaaEdgeThreshMin, lumaMax * FxaaEdgeThreshold)) {
		discard;
		return 0;
	}

	// ---- エッジ方向判定 (水平/垂直) ----
	float edgeH = abs(lumaN  + lumaS  - 2.0 * lumaM) * 2.0
	            + abs(lumaNE + lumaSE - lumaNW - lumaSW);
	float edgeV = abs(lumaE  + lumaW  - 2.0 * lumaM) * 2.0
	            + abs(lumaNE + lumaNW - lumaSE - lumaSW);
	bool horzSpan = (edgeH >= edgeV);

	// ---- サブピクセルブレンド係数 ----
	float lumaAvg  = (2.0 * (lumaN + lumaS + lumaE + lumaW)
	               +  lumaNE + lumaNW + lumaSE + lumaSW) / 12.0;
	float blendFac = saturate(abs(lumaAvg - lumaM) / lumaRange);
	blendFac = smoothstep(0.0, 1.0, blendFac);
	blendFac = blendFac * blendFac * FxaaSubpix;

	// ---- 隣接ピクセルとブレンド ----
	float3 result;
	if (horzSpan) {
		// 水平エッジ → 上下方向にブレンド
		float gradN = abs(lumaN - lumaM);
		float gradS = abs(lumaS - lumaM);
		result = (gradN >= gradS)
		       ? lerp(cM.rgb, cN.rgb, blendFac)
		       : lerp(cM.rgb, cS.rgb, blendFac);
	} else {
		// 垂直エッジ → 左右方向にブレンド
		float gradE = abs(lumaE - lumaM);
		float gradW = abs(lumaW - lumaM);
		result = (gradE >= gradW)
		       ? lerp(cM.rgb, cE.rgb, blendFac)
		       : lerp(cM.rgb, cW.rgb, blendFac);
	}

	RTOutput[pix] = float4(result, cM.a);

	discard;
	return 0;
}
#endif


// ===========================================================
// DENOISE パス: OIDNへの入力生成 (Preview から継承)
// ===========================================================
#ifdef YRZ_PASS_DENOISE
struct VSO {
	float4 position:SV_POSITION;
	float2 uv:TEXCOORD;
};

VSO VS( float4 pos : POSITION, float2 uv:TEXCOORD )
{
	VSO vso = (VSO)0;
	vso.position = pos;
	vso.position.w = 1;
	vso.uv = uv;
	return vso;
}

float4 PS(VSO vso) : SV_TARGET
{
	uint2 pix = trunc(vso.position);

	uint idx = pix.y * Resolution.x + pix.x;
	OIDNBuf[idx].color  = RTOutput[pix.xy].xyz;
	OIDNBuf[idx].albedo = RTOutput[pix.xy].xyz;
	OIDNBuf[idx].normal = float3(0, 0, 1);

	discard;
	return 0;
}
#endif


