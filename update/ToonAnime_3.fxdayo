[YRZFX]
{
    "fx": {
        "cereal_class_version": 0,
        "category": "render",
		"textures" : [
			{"name": "ZBuf",          "format": "D32_FLOAT",            "view": "DSV" },
			{"name": "RasterOut",     "format": "R16G16B16A16_FLOAT",   "view": "RTV" },
			{"name": "MyNormalDepth", "format": "R32G32B32A32_FLOAT",   "view": "RTV" },
			{"name": "MyGBuffer1",    "format": "R32G32B32A32_FLOAT",   "view": "RTV" },
			{"name": "MyGBuffer2",    "format": "R32G32_FLOAT",         "view": "RTV" },
			{"name": "TempBuffer",    "format": "R16G16B16A16_FLOAT",   "view": "RTV" },
		],
		"samplers" : [
			{ "name":"samp",      "filter":"ANISOTROPIC" },
			{ "name":"ClampSamp", "filter":"LINEAR", "addressU":"CLAMP", "addressV":"CLAMP" },
			{ "name":"SkySamp",   "filter":"LINEAR", "addressU":"WRAP",  "addressV":"CLAMP" }
		],
        "passes": [
			{
				"name":"BG", "type":"postprocess",
				"pixelShader": "PS", "vertexShader": "VS",
				"RTV": [ {"name":"RasterOut", "clear":true, "value":{"x":0, "y":0, "z":0, "w":0} } ]
			},
			{
				"name": "MMD",
				"type": "rasterizer", "vertexShader": "VS", "pixelShader": "PS",
				"DSV": { "name": "ZBuf", "clear": true, "depth": 1.0 },
				"RTV": [ { "name": "RasterOut", "clear":false } ],
				"blendDesc": {
					"renderTarget0": {
						"blendEnable": true,
						"srcBlend": "src_alpha", "destBlend": "inv_src_alpha", "blendOp": "add",
						"srcBlendAlpha": "one",  "destBlendAlpha": "inv_src_alpha", "blendOpAlpha": "add"
					}
				},
				"rasterizerDesc": { "cullMode": "none" }
			},
			{
				"name": "GBuffer",
				"type": "rasterizer", "vertexShader": "VS", "pixelShader": "PS",
				"DSV": { "name": "ZBuf", "clear": true, "depth": 1.0 },
				"RTV": [
					{ "name": "MyNormalDepth", "clear":true, "value":{"x":0, "y":0, "z":0, "w":0} },
					{ "name": "MyGBuffer1",    "clear":true, "value":{"x":-1,"y":-1,"z":-1,"w":-1} },
					{ "name": "MyGBuffer2",    "clear":true, "value":{"x":0, "y":0, "z":0, "w":0} }
				],
				"rasterizerDesc": { "cullMode": "none" }
			},
			{
				"name": "AnimeEffect", "type": "postprocess",
				"pixelShader": "PS", "vertexShader": "VS",
				"RTV": [ {"name": "TempBuffer", "clear":false} ]
			},
			{
				"name": "FXAA", "type": "postprocess",
				"pixelShader": "PS", "vertexShader": "VS",
				"RTV": [ {"name": "RasterOut", "clear":false} ]
			},
			{"name":"Copy",    "type":"postprocess", "pixelShader": "PS", "vertexShader": "VS"},
			{"name":"DENOISE", "type":"postprocess", "pixelShader": "PS", "vertexShader": "VS", "conditions":["DenoiserEnabled"]},
        ]
    }
}
[HLSL]

#include "../hlsl/resources.hlsli"
#include "../hlsl/yrz.hlsli"
using namespace Dayo;
using namespace YRZ;

#define NURI NonUniformResourceIndex


// ============================================================
//  BG パス ― スカイボックス描画
// ============================================================
#ifdef YRZ_PASS_BG
struct VSO {
	float4 position : SV_POSITION;
	float2 uv       : TEXCOORD;
};

VSO VS(float4 pos : POSITION, float2 uv : TEXCOORD)
{
	VSO vso = (VSO)0;
	vso.position   = pos;
	vso.position.w = 1;
	vso.uv         = uv;
	return vso;
}

void RaySaySay(float2 Tex, out float3 ray, out float3 pos, uniform bool normalizeFlag = true)
{
	float2 tex = (Tex.xy - 0.5) * 2.0;
	if (Perspective) {
		ray =
			ViewMatrix._13_23_33 / ProjectionMatrix._33
			+ (ViewMatrix._11_21_31 * tex.x / ProjectionMatrix._11)
			- (ViewMatrix._12_22_32 * tex.y / ProjectionMatrix._22);
		if (normalizeFlag) ray = normalize(ray);
		pos = CameraPosition;
	} else {
		ray = CameraForward;
		pos = CameraPosition
		    + CameraRight * tex.x / ProjectionMatrix._11
		    - CameraUp   * tex.y / ProjectionMatrix._22;
	}
}

static float SkyboxPhi = 0;

float2 LongRat(float3 v)
{
	return float2(atan2(v.z, v.x), acos(v.y)) / float2(-2 * PI, PI)
	       - float2(0.25 + SkyboxPhi, 0);
}

float4 PS(VSO vso) : SV_TARGET
{
	float3 rd, ro;
	RaySaySay(vso.uv, rd, ro);
	float4 o = Skybox.SampleLevel(SkySamp, LongRat(rd), 0);
	return float4(o.rgb, 0);   // 背景はα=0
}
#endif


// ============================================================
//  MMD / GBuffer パス ― モデル描画
// ============================================================
#if defined(YRZ_PASS_MMD) || defined(YRZ_PASS_GBuffer)
struct VSO {
	float4 position : SV_POSITION;
	float3 normal   : NORMAL;
	float2 uv       : TEXCOORD;
	float2 spuv     : TEXCOORD1;
	float3 eye      : TEXCOORD2;
};

VSO VS(float4 pos : POSITION, float3 normal : NORMAL, float3 tangent : TANGENT, float2 uv : TEXCOORD)
{
	VSO o = (VSO)0;
	o.position = mul(pos, ViewProjectionMatrix);
	o.uv       = uv;
	o.spuv     = mul(normal, (float3x2)ViewMatrix) * float2(0.5, -0.5) + 0.5;
	o.normal   = normal;
	o.eye      = CameraPosition - pos.xyz;
	return o;
}

float4 MMDColor(VSO vso, uint iFace, bool vface)
{
	uint imo = ModelIndex;
	MMDMaterial m = MMDMaterials[imo][Faces[imo][iFace]];

	if (!vface && ((m.drawFlag & 1) == 0)) discard;

	float4 o;
	float3 Le = LightColor;
	float3 L  = -LightDirection;
	float3 N  = vso.normal;
	float3 V  = normalize(vso.eye);
	float3 H  = normalize(L + V);
	float  NoL = dot(N, L);
	uint tidx = TextureTable[imo];

	float4 tex = 1;
	if (m.tex >= 0) {
		tex = Textures[NURI(tidx + m.tex)].Sample(samp, vso.uv);
		tex.rgb = lerp(1,
		    tex.rgb * m.textureMulValue.rgb + m.textureAddValue.rgb,
		    m.textureMulValue.a + m.textureAddValue.a);
	}

	o = float4(saturate(m.diffuse.rgb * Le + m.ambient), m.diffuse.a) * tex;

	if (m.toonFlag == 0 && m.toonTex >= 0) {
		o *= Textures[NURI(tidx + m.toonTex)].Sample(ClampSamp, float2(0, 0.5 - NoL * 0.5));
	} else if (m.toonFlag == 1) {
		o.rgb *= lerp(0.5, 1, smoothstep(-0.1, 0.1, NoL));
	}

	if (m.spTex >= 0 && (m.spmode == 1 || m.spmode == 2)) {
		float4 sptex = Textures[NURI(tidx + m.spTex)].Sample(samp, vso.spuv);
		sptex.rgb = lerp(m.spmode == 1 ? 1 : 0,
		    sptex.rgb * m.sphereMulValue.rgb + m.sphereAddValue.rgb,
		    m.sphereAddValue.a + m.sphereMulValue.a);
		o.rgb = (m.spmode == 1) ? o.rgb * sptex.rgb : o.rgb + sptex.rgb;
		o.a  *= sptex.a;
	}

	o.rgb += m.specular * Le * pow(max(1e-6, dot(N, H)), m.shininess);

	if (o.a == 0)    discard;
	if (o.a >= 0.98) o.a = 1;

	o.rgb = ToLinear(o.rgb);
	return o;
}

	#ifdef YRZ_PASS_MMD
		float4 PS(VSO vso, uint iFace : SV_PrimitiveID, bool vface : SV_IsFrontFace) : SV_TARGET
		{
			return MMDColor(vso, iFace, vface);
		}
	#else
		struct PSO {
			float4 NormalDepth : SV_TARGET0;
			float4 GBuffer1    : SV_TARGET1;
			float2 GBuffer2    : SV_TARGET2;
		};

		#ifndef NO_BARYCENTRICS
		PSO PS(VSO vso, uint iFace : SV_PrimitiveID, bool vface : SV_IsFrontFace, float3 bary : SV_Barycentrics) {
		#else
		PSO PS(VSO vso, uint iFace : SV_PrimitiveID, bool vface : SV_IsFrontFace) {
			float3 bary = 0;
		#endif
			float4 c = MMDColor(vso, iFace, vface);
			if (c.a < AlphaThreshold) discard;
			PSO o        = (PSO)0;
			o.NormalDepth = float4(vso.normal, vso.position.w);
			o.GBuffer1.r  = ModelIndex & 0x00FFFFFF;
			o.GBuffer1.g  = ModelIndex >> 24;
			o.GBuffer1.b  = iFace & 0x00FFFFFF;
			o.GBuffer1.a  = iFace >> 24;
			o.GBuffer2    = bary.yz;
			return o;
		}
	#endif
#endif


// ============================================================
//  Copy パス ― RasterOut → RTOutput & GBuffer コピー
// ============================================================
#ifdef YRZ_PASS_Copy
struct VSO {
	float4 position : SV_POSITION;
	float2 uv       : TEXCOORD;
};

VSO VS(float4 pos : POSITION, float2 uv : TEXCOORD)
{
	VSO vso = (VSO)0;
	vso.position   = pos;
	vso.position.w = 1;
	vso.uv         = uv;
	return vso;
}

float4 PS(VSO vso) : SV_TARGET
{
	uint2 pix = trunc(vso.position.xy);
	RTOutput[pix] = RasterOut[pix];

	float4 G1 = MyGBuffer1[pix];
	GBuffer1[pix].r = (G1.r < 0) ? -1 : (uint)G1.r | ((uint)G1.g << 24);
	GBuffer1[pix].g = (G1.b < 0) ? -1 : (uint)G1.b | ((uint)G1.a << 24);

	GBuffer2[pix]    = MyGBuffer2[pix];
	NormalDepth[pix] = MyNormalDepth[pix];
	discard;
	return 0;
}
#endif


// ============================================================
//  DENOISE パス ― OIDN 入力生成
// ============================================================
#ifdef YRZ_PASS_DENOISE
struct VSO {
	float4 position : SV_POSITION;
	float2 uv       : TEXCOORD;
};

VSO VS(float4 pos : POSITION, float2 uv : TEXCOORD)
{
	VSO vso = (VSO)0;
	vso.position   = pos;
	vso.position.w = 1;
	vso.uv         = uv;
	return vso;
}

float4 PS(VSO vso) : SV_TARGET
{
	uint2  pix = trunc(vso.position);
	uint   idx = pix.y * Resolution.x + pix.x;
	OIDNBuf[idx].color  = RTOutput[pix].xyz;
	OIDNBuf[idx].albedo = RTOutput[pix].xyz;
	OIDNBuf[idx].normal = float3(0, 0, 1);
	discard;
	return 0;
}
#endif


// ============================================================
//  AnimeEffect パス
//  ① 彩度ブースト  ② Diffusion（拡散グロー）  ③ アニメ風エッジ
//  RasterOut + MyNormalDepth → TempBuffer
// ============================================================
#ifdef YRZ_PASS_AnimeEffect

struct VSO {
	float4 position : SV_POSITION;
	float2 uv       : TEXCOORD;
};

VSO VS(float4 pos : POSITION, float2 uv : TEXCOORD)
{
	VSO vso = (VSO)0;
	vso.position   = pos;
	vso.position.w = 1;
	vso.uv         = uv;
	return vso;
}

// ───────────────────────────────────────────
//  ★ 調整パラメータ ― ここで効果を微調整できます
// ───────────────────────────────────────────

// 彩度倍率 : 1.0=変化なし / 1.5=50%増 / 2.0=2倍
static const float SatBoost = 1.55;

// エッジ強度 : 0.0=なし / 1.0=標準 / 2.0=強め
static const float EdgeStrength = 1.1;

// 深度エッジ感度 (小さいほど細かい凹凸も検出)
static const float EdgeDepthSens = 0.07;

// 法線エッジ感度 (小さいほど素材境界を強調)
static const float EdgeNormSens = 0.45;

// エッジカラー (アニメ的な深い黒)
static const float3 EdgeCol = float3(0.02, 0.02, 0.04);

// Diffusion 強度 : 0.0=なし / 0.1=微光 / 0.3=強め
static const float DiffStrength = 0.13;

// Diffusion 輝度しきい値 (線形空間, これ以上の輝度が滲む)
static const float DiffThreshold = 0.58;

// Diffusion 色調 (わずかに暖色寄り)
static const float3 DiffTint = float3(1.00, 0.97, 0.94);

// ───────────────────────────────────────────
//  ユーティリティ関数
// ───────────────────────────────────────────

// 線形輝度 (Rec.709)
float Luma(float3 c)
{
	return dot(c, float3(0.2126, 0.7152, 0.0722));
}

// 彩度調整
float3 AdjSat(float3 c, float sat)
{
	float L = Luma(c);
	return lerp(float3(L, L, L), c, sat);
}

// 範囲クランプ付き RasterOut サンプル
float4 SmpRaster(int2 p)
{
	p = clamp(p, int2(0, 0), int2(Resolution) - 1);
	return RasterOut[p];
}

// 範囲クランプ付き NormalDepth サンプル
float4 SmpND(int2 p)
{
	p = clamp(p, int2(0, 0), int2(Resolution) - 1);
	return MyNormalDepth[p];
}

// ───────────────────────────────────────────
//  ピクセルシェーダー
// ───────────────────────────────────────────
float4 PS(VSO vso) : SV_TARGET
{
	int2 pix = int2(trunc(vso.position.xy));

	// ---- ベースカラー取得 ----
	float4 base = RasterOut[pix];

	// ===========================
	//  ① Diffusion（拡散グロー）
	//  エッジ合成前に元画像から輝度の高い部分を滲ませる
	// ===========================
	float3 diffAcc   = 0;
	float  diffTotalW = 0;

	// 13 点近似ガウシアン（半径 2px）
	static const int2 dOff[12] = {
		int2(-2,-2), int2(0,-2), int2(2,-2),
		int2(-2, 0),             int2(2, 0),
		int2(-2, 2), int2(0, 2), int2(2, 2),
		int2(-1,-1), int2(1,-1),
		int2(-1, 1), int2(1, 1)
	};
	static const float dW[12] = {
		0.5, 0.8, 0.5,
		0.8,      0.8,
		0.5, 0.8, 0.5,
		1.0, 1.0,
		1.0, 1.0
	};

	[unroll]
	for (int j = 0; j < 12; j++) {
		float3 sc = AdjSat(SmpRaster(pix + dOff[j]).rgb, SatBoost);
		float  lm = Luma(sc);
		// しきい値以上の輝度だけグローに寄与
		float  gf = saturate((lm - DiffThreshold) / max(1e-5, 1.0 - DiffThreshold));
		float  w  = dW[j] * gf;
		diffAcc    += sc * w;
		diffTotalW += dW[j];
	}
	float3 diffGlow = (diffTotalW > 0) ? (diffAcc / diffTotalW) : 0;

	// ===========================
	//  ② 彩度ブースト
	// ===========================
	float3 color = AdjSat(base.rgb, SatBoost);

	// Diffusion を加算合成
	color += diffGlow * DiffTint * DiffStrength;

	// ===========================
	//  ③ アニメ風エッジ検出
	//  深度 + 法線の Sobel フィルタで輪郭を検出し黒アウトラインを描く
	// ===========================
	float4 nd = SmpND(pix);
	float  depC = nd.w;       // 中心深度
	float3 norC = nd.xyz;     // 中心法線

	// 3×3 Sobel カーネルのサンプル
	float4 nd00 = SmpND(pix + int2(-1,-1));
	float4 nd10 = SmpND(pix + int2( 0,-1));
	float4 nd20 = SmpND(pix + int2( 1,-1));
	float4 nd01 = SmpND(pix + int2(-1, 0));
	float4 nd21 = SmpND(pix + int2( 1, 0));
	float4 nd02 = SmpND(pix + int2(-1, 1));
	float4 nd12 = SmpND(pix + int2( 0, 1));
	float4 nd22 = SmpND(pix + int2( 1, 1));

	// ---- 深度 Sobel ----
	float GxD = (-nd00.w - 2*nd01.w - nd02.w) + (nd20.w + 2*nd21.w + nd22.w);
	float GyD = (-nd00.w - 2*nd10.w - nd20.w) + (nd02.w + 2*nd12.w + nd22.w);
	float edgeDepth = sqrt(GxD*GxD + GyD*GyD);

	// ---- 法線 Sobel ----
	float3 GxN = (-nd00.xyz - 2*nd01.xyz - nd02.xyz) + (nd20.xyz + 2*nd21.xyz + nd22.xyz);
	float3 GyN = (-nd00.xyz - 2*nd10.xyz - nd20.xyz) + (nd02.xyz + 2*nd12.xyz + nd22.xyz);
	float edgeNorm = length(GxN) + length(GyN);

	// 背景ピクセル（depth=0）はエッジ対象外
	float isObj = saturate(depC * 100.0);

	// エッジ強度の統合
	float ef = saturate(
		max(
			saturate(edgeDepth / EdgeDepthSens),
			saturate(edgeNorm  / EdgeNormSens)
		) * EdgeStrength
	) * isObj;

	// アニメ的な鋭いステップに整形（なだらかな移行を防ぐ）
	ef = smoothstep(0.25, 0.65, ef);

	// エッジ色を合成
	color = lerp(color, EdgeCol, ef);

	return float4(color, base.a);
}
#endif


// ============================================================
//  FXAA パス ― Fast Approximate Anti-Aliasing
//  TempBuffer（AnimeEffect の出力）→ RasterOut
//  ルマベースのエッジ検出でジャギーを軽減しつつ輪郭を保持
// ============================================================
#ifdef YRZ_PASS_FXAA

struct VSO {
	float4 position : SV_POSITION;
	float2 uv       : TEXCOORD;
};

VSO VS(float4 pos : POSITION, float2 uv : TEXCOORD)
{
	VSO vso = (VSO)0;
	vso.position   = pos;
	vso.position.w = 1;
	vso.uv         = uv;
	return vso;
}

// FXAA パラメータ
static const float FXAA_THRESH_MIN = 0.0312;   // 最小コントラスト閾値
static const float FXAA_THRESH     = 0.125;    // エッジ検出コントラスト閾値
static const float FXAA_SUBPIX     = 0.75;     // サブピクセルブレンド品質 (0-1)

// 輝度 (Rec.601 γ空間近似)
float RGBLuma(float3 c)
{
	return dot(c, float3(0.299, 0.587, 0.114));
}

// 範囲クランプ付き TempBuffer サンプル
float4 SmpTemp(int2 p)
{
	p = clamp(p, int2(0, 0), int2(Resolution) - 1);
	return TempBuffer[p];
}

float4 PS(VSO vso) : SV_TARGET
{
	int2  pix = int2(trunc(vso.position.xy));
	float4 center = TempBuffer[pix];
	float3 colorC = center.rgb;
	float  lumaC  = RGBLuma(colorC);

	// 上下左右 4 近傍のルマ
	float3 colorN = SmpTemp(pix + int2( 0,-1)).rgb;
	float3 colorS = SmpTemp(pix + int2( 0, 1)).rgb;
	float3 colorE = SmpTemp(pix + int2( 1, 0)).rgb;
	float3 colorW = SmpTemp(pix + int2(-1, 0)).rgb;

	float lumaMin = min(lumaC, min(min(RGBLuma(colorN), RGBLuma(colorS)),
	                              min(RGBLuma(colorE), RGBLuma(colorW))));
	float lumaMax = max(lumaC, max(max(RGBLuma(colorN), RGBLuma(colorS)),
	                              max(RGBLuma(colorE), RGBLuma(colorW))));
	float lumaRange = lumaMax - lumaMin;

	// コントラストが小さければ AA をスキップ（輪郭部はそのまま保持）
	if (lumaRange < max(FXAA_THRESH_MIN, lumaMax * FXAA_THRESH))
		return center;

	// 斜め 4 方向のルマ
	float lumaNW = RGBLuma(SmpTemp(pix + int2(-1,-1)).rgb);
	float lumaNE = RGBLuma(SmpTemp(pix + int2( 1,-1)).rgb);
	float lumaSW = RGBLuma(SmpTemp(pix + int2(-1, 1)).rgb);
	float lumaSE = RGBLuma(SmpTemp(pix + int2( 1, 1)).rgb);
	float lumaN  = RGBLuma(colorN);
	float lumaS  = RGBLuma(colorS);
	float lumaE  = RGBLuma(colorE);
	float lumaW  = RGBLuma(colorW);

	// 水平・垂直エッジ強度（Sobel 的）
	float edgeH = abs(-2.0*lumaW + lumaNW + lumaSW)
	            + abs(-2.0*lumaC + lumaN  + lumaS ) * 2.0
	            + abs(-2.0*lumaE + lumaNE + lumaSE);
	float edgeV = abs(-2.0*lumaN + lumaNW + lumaNE)
	            + abs(-2.0*lumaC + lumaW  + lumaE ) * 2.0
	            + abs(-2.0*lumaS + lumaSW + lumaSE);

	bool isH = edgeH >= edgeV;

	// エッジ方向の両隣ルマ
	float luma1 = isH ? lumaS : lumaW;
	float luma2 = isH ? lumaN : lumaE;
	float grad1 = abs(luma1 - lumaC);
	float grad2 = abs(luma2 - lumaC);

	// 近傍ルマ平均（サブピクセル補正）
	float lumaAvg = (2.0 * (lumaN + lumaS + lumaE + lumaW)
	               + lumaNW + lumaNE + lumaSW + lumaSE) / 12.0;
	float sub1 = saturate(abs(lumaAvg - lumaC) / lumaRange);
	float sub2 = (-2.0 * sub1 + 3.0) * sub1 * sub1;
	float subBlend = sub2 * sub2 * FXAA_SUBPIX;

	// ブレンド先ピクセルを選択
	int2 blendDir = isH
		? (grad1 >= grad2 ? int2(0, 1) : int2(0,-1))
		: (grad1 >= grad2 ? int2(-1,0) : int2( 1, 0));

	float3 neighborColor = SmpTemp(pix + blendDir).rgb;
	float3 finalColor    = lerp(colorC, neighborColor, subBlend * 0.5);

	return float4(finalColor, center.a);
}
#endif
