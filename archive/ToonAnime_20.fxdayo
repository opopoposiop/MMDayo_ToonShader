// ============================================================
// BloomCompositeパス
// ============================================================
#ifdef YRZ_PASS_BloomComposite

struct VSO {
	float4 position:SV_POSITION;
	float2 uv:TEXCOORD;
};

VSO VS( float4 pos : POSITION, float2 uv:TEXCOORD )
{
	VSO vso = (VSO)0;
	vso.position = pos;
	vso.position.w = 1;
	vso.uv = uv;
	return vso;
}

float4 PS(VSO vso) : SV_TARGET
{
	uint2  pix  = (uint2)vso.position.xy;
	float3 tight = BloomBuf[pix].rgb;
	float3 wide  = BloomBuf3[pix].rgb;
	RTOutput[pix] += float4(tight * BLOOM_INTENSITY + wide * BLOOM_WIDE_INTENSITY, 0.0);
	discard;
	return 0;
}

